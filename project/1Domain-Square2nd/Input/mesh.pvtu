    <PCellData>
      <PDataArray type="Int32" Name="rank"/>
      <PDataArray type="Int32" Name="color"/>
      <PDataArray type="Int32" Name="CellEntityIds"/>
    </PCellData>
    <PPoints>
      <PDataArray type="Float64" Name="Points" NumberOfComponents="3"/>
    </PPoints>
    <Piece Source="Comp_SQ2_part_0.vtu"/>
    <Piece Source="Comp_SQ2_part_1.vtu"/>
    <Piece Source="Comp_SQ2_part_2.vtu"/>
    <Piece Source="Comp_SQ2_part_3.vtu"/>
