<?xml version="1.0"?>
<VTKFile type="PUnstructuredGrid" version="1.0" byte_order="LittleEndian">
  <PUnstructuredGrid GhostLevel="0">
    <PPointData>
      <PDataArray type="Int32" Name="global_node_id"/>
      <PDataArray type="Int32" Name="node_type"/>
      <PDataArray type="Int32" Name="num_sharing_ranks"/>
      <PDataArray type="Int32" Name="owner_ranks" NumberOfComponents="4"/>
