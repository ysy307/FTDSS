<?xml version="1.0"?>
<VTKFile type="PUnstructuredGrid" version="2.0" byte_order="LittleEndian">
  <PUnstructuredGrid GhostLevel="0">
    <PPointData>
      <PDataArray type="Int32" Name="global_node_id"/>
      <PDataArray type="Int32" Name="node_type"/>
      <PDataArray type="Int32" Name="num_sharing_ranks"/>
      <PDataArray type="Int32" Name="owner_ranks" NumberOfComponents="4"/>
      <PDataArray type="Int32" Name="communication_partners" NumberOfComponents="4"/>
    </PPointData>
    <PCellData>
      <PDataArray type="Int32" Name="rank"/>
      <PDataArray type="Int32" Name="color"/>
      <PDataArray type="Int64" Name="CellEntityIds"/>
    </PCellData>
    <PPoints>
      <PDataArray type="Float64" Name="Points" NumberOfComponents="3"/>
    </PPoints>
    <Piece Source="mesh_0.vtu"/>
    <Piece Source="mesh_1.vtu"/>
    <Piece Source="mesh_2.vtu"/>
    <Piece Source="mesh_3.vtu"/>
  </PUnstructuredGrid>
</VTKFile>
