{
    "source_dirs": [
        "**/src",
        "**/app",
        "**/test"
    ],
    "mod_dirs": [
        "/opt/intel/oneapi/mpi/2021.14/include/mpi",
        "/opt/intel/oneapi/2025.0/include/mpi",
        "/workspaces/FTDSS/third_party/.local/include",
        "/workspaces/FTDSS/third_party/.local/jsonfortran-*/lib",
        "/workspaces/FTDSS/third_party/.local/include/fortran_stdlib/**/*",
        "/workspaces/FTDSS/third_party/.local/jsonfortran-intelllvm-*/lib",
        "/workspaces/FTDSS/CMakeBuild/.mod"
    ],
    "preprocessor": {
        "defines": [
            "_MKL"
        ]
    },
    "exclude_files": [
        "CMakeBuild/**",
        "third_party/**",
        ".git/**",
        ".vscode/**",
        ".archive/**",
        ".devcontainer/**",
        "build/**",
        "github/**",
        "docs/**",
        "fpm/**",
        "Inout/**",
        "log/**",
        "Scripts/**"
    ],
    "lowercase_intrinsics": true,
    "hover_signature": true,
    "use_signature_help": true,
    "incremental_sync": true
}