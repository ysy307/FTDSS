{
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.renderLineHighlight": "all",
    "editor.dragAndDrop": false,
    "editor.acceptSuggestionOnEnter": "off",
    "files.autoSave": "onWindowChange",
    "files.associations": {
        "*.FOR": "FortranFreeForm",
        "*.f95": "FortranFreeForm",
        "*.f03": "FortranFreeForm",
        "*.f90": "FortranFreeForm",
        "*.F90": "FortranFreeForm"
    },
    "fortran.fortls.path": "/usr/local/bin/fortls",
    // "fortran.fortls.extraArgs": [
    //     "--config",
    //     ".vscode/.fortls"
    // ],
    "fortran.linter.extraArgs": [
        "-fpp",
        "-module",
        "/workspaces/FTDSS/CMakeBuild/.mod",
        "-module",
        "/opt/intel/oneapi/mpi/2021.14/include/mpi",
        "-module",
        "/opt/intel/oneapi/2025.1/include/mpi",
        "-module",
        "-isystem",
        "/workspaces/FTDSS/EXTERNAL/fortran_stdlib/include/fortran_stdlib/IntelLLVM-2025.0.4",
        "-I/workspaces/FTDSS/include/Json-Fortran",
        "-I/workspaces/FTDSS/include/VTKFortran",
        "/workspaces/FTDSS/lib/libjsonfortran-static.a",
        "/workspaces/FTDSS/lib/libjsonfortran.a",
        "/workspaces/FTDSS/lib/libtomlf.a",
        "/workspaces/FTDSS/lib/libvtkfortran.a",
        "/workspaces/FTDSS/EXTERNAL/fortran_stdlib/lib/libfortran_stdlib.a",
        "-D_MKL"
    ],
    "fortran.linter.compiler": "ifx",
    "fortran.linter.compilerPath": "/opt/intel/oneapi/compiler/latest/bin/ifx",
    "fortran.linter.includePaths": [
        "/workspaces/FTDSS/CMakeBuild/.mod/",
        "/opt/intel/oneapi/mkl/latest/include/",
        "/opt/intel/oneapi/mpi/latest/include/",
        "/opt/intel/oneapi/2025.0/include/",
        "/workspaces/FTDSS/include/VTKFortran",
        "/workspaces/FTDSS/include/tomlf",
        "/workspaces/FTDSS/include/Json-Fortran",
        "/workspaces/FTDSS/EXTERNAL/fortran_stdlib/include/fortran_stdlib/IntelLLVM-2025.0.4",
    ],
    "fortran.linter.modOutput": "/workspaces/FTDSS/CMakeBuild/.mod/",
    "fortran.formatting.formatter": "fprettify",
    "fortran.formatting.fprettifyArgs": [
        "--indent",
        "4",
        "--whitespace",
        "4",
        "--whitespace-comma",
        "true",
        "--whitespace-assignment",
        "true",
        "--whitespace-relational",
        "true",
        "--whitespace-logical",
        "true",
        "--whitespace-plusminus",
        "true",
        "--whitespace-multdiv",
        "true",
        "--whitespace-print",
        "true",
        "--whitespace-intrinsics",
        "true",
        "--whitespace-decl",
        "true",
        "--whitespace-type",
        "false",
        "--strip-comments",
        "--case",
        "1",
        "1",
        "1",
        "1",
        "--line-length",
        "256",
        "--silent",
        "--enable-decl",
        "--whitespace-decl",
        "true"
    ],
    "fortran.preferredCase": "lowercase",
    "[FortranFreeForm]": {
        "files.autoGuessEncoding": true,
        "files.encoding": "utf8"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.tmp.drive*": true
    },
    "docker.commands.attach": "${containerCommand} exec -it ${containerId} zsh",
    "workbench.colorCustomizations": {
        "editor.background": "#2e282c"
    },
    "editor.tokenColorCustomizations": {
        "comments": {
            "foreground": "#876487",
            "fontStyle": "italic",
        },
        "functions": "#99bcf0",
        "keywords": "#dbf",
        "numbers": "#f99",
        "strings": "#df8",
        "types": "#fb6",
        "variables": "#ddd",
    },
    "editor.rulers": [
        132
    ],
    "fortran.fortls.preprocessor.suffixes": [
        "F90"
    ],
}