{
    // =========================================================================
    // エディタ基本設定
    // =========================================================================
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.renderLineHighlight": "all",
    "editor.dragAndDrop": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.rulers": [
        132
    ],
    // =========================================================================
    // ファイル設定
    // =========================================================================
    "files.autoSave": "onWindowChange",
    "files.associations": {
        "*.FOR": "FortranFreeForm",
        "*.f95": "FortranFreeForm",
        "*.f03": "FortranFreeForm",
        "*.f90": "FortranFreeForm",
        "*.F90": "FortranFreeForm",
        "*.py": "python",
        "*.vtu": "xml",
        "stdint.h": "c"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.tmp.drive*": true
    },
    "[FortranFreeForm]": {
        "files.autoGuessEncoding": true,
        "files.encoding": "utf8"
    },
    // =========================================================================
    // Fortran 拡張機能設定
    // =========================================================================
    // --- リンター & Language Server (fortls) ---
    // fortls実行ファイルのパス (環境に合わせて変更が必要な場合があります)
    "fortran.fortls.path": "/usr/local/bin/fortls",
    // プリプロセッサを有効にするファイルの拡張子
    "fortran.fortls.preprocessor.suffixes": [
        "F90"
    ],
    //
    // ▼▼▼ 以下の linter 設定はプロジェクトルートの .fortls ファイルに移行しました ▼▼▼
    // fortran.linter.includePaths -> .fortls の "mod_dirs"
    // fortran.linter.extraArgs    -> .fortls の "preprocessor.defines"
    // fortran.linter.compiler* -> fortlsが自動で判断するため不要
    // fortran.linter.modOutput    -> fortlsが自動で判断するため不要
    //
    // --- フォーマッター (fprettify) ---
    "fortran.formatting.formatter": "fprettify",
    // fprettifyの引数を整理しました
    "fortran.formatting.fprettifyArgs": [
        "--indent",
        "4",
        "--enable-decl",
        "--line-length",
        "256",
        "--strip-comments",
        "--silent"
    ],
    "fortran.preferredCase": "lowercase",
    // =========================================================================
    // UI カスタマイズ
    // =========================================================================
    "workbench.colorCustomizations": {
        "editor.background": "#2e282c"
    },
    "editor.tokenColorCustomizations": {
        "comments": {
            "foreground": "#876487",
            "fontStyle": "italic"
        },
        "functions": "#99bcf0",
        "keywords": "#dbf",
        "numbers": "#f99",
        "strings": "#df8",
        "types": "#fb6",
        "variables": "#ddd"
    },
    // =========================================================================
    // Docker / コンテナ設定
    // =========================================================================
    "containers.commands.attach": "${containerCommand} exec -it ${containerId} zsh"
}