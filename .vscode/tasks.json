{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build cmake",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}/",
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": "zsh",
            "args": [
                "scripts/Compile-Cmake-test.sh",
                ">|",
                "log/compile.log"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "cmake build & run",
            "type": "shell",
            "options": {
                "cwd": "${workspaceRoot}/CMakeBuild",
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": "cmake",
            "args": [
                "-S",
                "..",
                "-DBUILD_APP=ysy_fc",
                "-B",
                ".",
                "&&",
                "cmake",
                "--build",
                ".",
                "&&",
                "cmake",
                "--build",
                ".",
                "--target",
                "run_ysy_fc"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Reset cmake build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "command": "find CMakeBuild -mindepth 1 -delete",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}