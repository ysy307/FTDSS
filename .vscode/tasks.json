{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FTDSS Build (intel) & Analyze",
            "type": "shell",
            "command": "python3",
            "args": [
                "scripts/compile/compile.py",
                "-c",
                "intel",
                "-t",
                "main"
            ],
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "FTDSS Build (gnu) & Analyze",
            "type": "shell",
            "command": "python3",
            "args": [
                "scripts/compile/compile.py",
                "-c",
                "gnu",
                "-t",
                "main"
            ],
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Reset cmake build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "command": "find CMakeBuild_* -mindepth 1 -delete",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}