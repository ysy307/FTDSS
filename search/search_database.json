tall ( self % num_partners * 2 , reqs , statuses , ierr ) call handle_mpi_error ( ierr , \"MPI_Waitall for scalar exchange\" ) deallocate ( reqs , statuses ) if ( total_recv_nodes > 0 ) then select case ( operation ) case ( OP_UPDATE ) data_array ( self % recv_indices ( 1 : total_recv_nodes )) = self % recv_buf ( 1 : total_recv_nodes ) case ( OP_ASSEMBLE ) data_array ( self % recv_indices ( 1 : total_recv_nodes )) = data_array ( self % recv_indices ( 1 : total_recv_nodes )) + & self % recv_buf ( 1 : total_recv_nodes ) end select end if end subroutine exchange_and_operate_scalar_impl","tags":"","url":"proc/exchange_and_operate_scalar_impl.html"},{"title":"exchange_and_operate_vector_impl – FTDSS","text":"private  subroutine exchange_and_operate_vector_impl(self, data_array, num_components, operation) Type Bound type_halo_communicator Arguments Type Intent Optional Attributes Name class( type_halo_communicator ), intent(inout) :: self real(kind=real64), intent(inout) :: data_array (:,:) integer(kind=int32), intent(in) :: num_components integer(kind=int32), intent(in) :: operation Calls proc~~exchange_and_operate_vector_impl~~CallsGraph proc~exchange_and_operate_vector_impl type_halo_communicator%exchange_and_operate_vector_impl mpi_irecv mpi_irecv proc~exchange_and_operate_vector_impl->mpi_irecv mpi_isend mpi_isend proc~exchange_and_operate_vector_impl->mpi_isend mpi_waitall mpi_waitall proc~exchange_and_operate_vector_impl->mpi_waitall proc~ensure_buffers_ready type_halo_communicator%ensure_buffers_ready proc~exchange_and_operate_vector_impl->proc~ensure_buffers_ready proc~handle_mpi_error handle_mpi_error proc~exchange_and_operate_vector_impl->proc~handle_mpi_error deallocate_array deallocate_array proc~ensure_buffers_ready->deallocate_array mpi_abort mpi_abort proc~handle_mpi_error->mpi_abort mpi_comm_rank mpi_comm_rank proc~handle_mpi_error->mpi_comm_rank mpi_error_string mpi_error_string proc~handle_mpi_error->mpi_error_string Help Graph Key Nodes of different co