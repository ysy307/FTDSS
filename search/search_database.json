 self real ( real64 ), intent ( in ) :: h real ( real64 ) :: thetaW if ( h < self % hcrit ) then thetaW = self % thetaR + ( self % thetaS - self % thetaR ) * ( 1.0d0 + abs ( self % alpha1 * h ) ** self % n1 ) ** ( - self % m1 ) else thetaW = self % thetaS end if end function Calculate_WRF_MVG","tags":"","url":"proc/calculate_wrf_mvg.html"},{"title":"Calculate_WRF_MVG_Derivative – FTDSS","text":"module function Calculate_WRF_MVG_Derivative(self, h) result(Cw) Arguments Type Intent Optional Attributes Name class(Type_WRF_MVG), intent(in) :: self real(kind=real64), intent(in) :: h Return Value real(kind=real64) Source Code module function Calculate_WRF_MVG_Derivative ( self , h ) result ( Cw ) implicit none class ( Type_WRF_MVG ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ) :: Cw if ( h < self % hcrit ) then Cw = ( self % thetaS - self % thetaR ) * & self % alpha1 ** self % n1 * self % m1 * self % n1 * ( - h ) ** ( self % n1 - 1.0d0 ) * & ( 1.0d0 + ( - self % alpha1 * h ) ** self % n1 ) ** ( - self % m1 - 1.0d0 ) else Cw = 0.0d0 end if end function Calculate_WRF_MVG_Derivative","tags":"","url":"proc/calculate_wrf_mvg_derivative.html"},{"title":"Type_Condition_IC_CRS_Construct – FTDSS","text":"module function Type_Condition_IC_CRS_Construct(Input, type) result(Structure) Interface → Arguments Type Intent Optional Attributes Name type( Type_Input ), intent(in) :: Input character(len=*), intent(in) :: type Return Value class( Abstract_Condition_IC ), allocatable Called by proc~~type_condition_ic_crs_construct~~CalledByGraph proc~type_condition_ic_crs_construct Type_Condition_IC_CRS_Construct interface~type_condition_ic_crs_construct Type_Condition_IC_CRS_Construct interface~type_condition_ic_crs_construct->proc~type_condition_ic_crs_construct interface~type_condition_ic_crs Type_Condition_IC_CRS interface~type_condition_ic_crs->interface~type_condition_ic_crs_construct Help Graph Key Nodes of different colours represent the following: Graph K