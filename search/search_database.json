elf % h_crit * scale_pres self % alpha2 = self % alpha2 * scale_pres case ( WRF_VG , WRF_MVG , WRF_DURNER , WRF_DVGCH ) self % alpha1 = self % alpha1 / scale_pres self % alpha2 = self % alpha2 / scale_pres self % h_crit = self % h_crit * scale_pres case default self % alpha1 = self % alpha1 / scale_pres self % h_crit = self % h_crit * scale_pres end select end subroutine convert_params_wrf","tags":"","url":"proc/convert_params_wrf.html"},{"title":"copy_params_wrf – FTDSS","text":"module subroutine copy_params_wrf(self, source) Arguments Type Intent Optional Attributes Name class(type_wrf_params), intent(inout) :: self type(type_wrf_params), intent(in) :: source Source Code module subroutine copy_params_wrf ( self , source ) implicit none class ( type_wrf_params ), intent ( inout ) :: self type ( type_wrf_params ), intent ( in ) :: source self % unit_id = source % unit_id self % model_number = source % model_number self % theta_s = source % theta_s self % theta_r = source % theta_r self % alpha1 = source % alpha1 self % n1 = source % n1 self % m1 = source % m1 self % h_crit = source % h_crit self % alpha2 = source % alpha2 self % n2 = source % n2 self % m2 = source % m2 self % w1 = source % w1 self % w2 = source % w2 end subroutine copy_params_wrf","tags":"","url":"proc/copy_params_wrf.html"},{"title":"initialize_abst_wrf – FTDSS","text":"module subroutine initialize_abst_wrf(self, params) Arguments Type Intent Optional Attributes Name class(abst_wrf), intent(inout) :: self type(type_wrf_params), intent(in) :: params Calls proc~~initialize_abst_wrf~~CallsGraph proc~initialize_abst_wrf initialize_abst_wrf convert convert proc~initialize_abst_wrf->convert copy copy proc~initialize_abst_wrf->copy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine initialize_abst_wrf ( self , params ) implicit none class ( abst_wrf ), intent ( inout ) :: self type ( type_wrf_params ), intent ( in ) :: params call self % params % copy ( params ) call self % params % convert ( params % unit_id ) self % initialized = . true . end subroutine initialize_abst_wrf","tags":"","url":"proc/initialize_abst_wrf.html"},{"title":"initialize_holder_wrfs – FTDSS","text":"module subroutine initialize_holder_wrfs(self, material_id, params) Arguments Type Intent Optional Attributes Name class(holder_wrfs), intent(inout) :: self integer(kind=int32), intent(in) :: material_id type(type_wrf_params), intent(in) :: params Calls proc~~initialize_holder_wrfs~~CallsGraph proc~initialize_holder_wrfs initialize_holder_wrfs initialize initialize proc~initialize_holder_wrfs->initialize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine initialize_holder_wrfs ( self , material_id , params ) implicit none class ( holder_wrfs ), intent ( inout ) :: self integer ( int32 ), intent ( in ) :: material_id type ( type_wrf_params ), intent ( in ) :: params if ( allocated ( self % p )) then deallocate ( self % p ) end if select case ( params % model_number ) case ( WRF_BC ) allocate ( type_wrf_bc :: self % p ) case ( WRF_VG ) allocate ( type_wrf_vg :: self % p ) case ( WRF_KO ) allocate ( type_wrf_ko :: self % p ) case ( WRF_MVG ) allocate ( type_wrf_mvg :: self % p ) case ( WRF_DURNER ) allocate ( type_wrf_durner :: self % p ) case ( WRF_DVGCH ) allocate ( type_wrf_dvgch :: self % p ) case default write ( * , * ) 'Error: Unknown WRF model number ' , params % model_number stop end select call self % p % initialize ( params ) end subroutine initialize_holder_wrfs","tags":"","url":"proc/initialize_holder_wrfs.html"},{"title":"reset_params_wrf – FTDSS","text":"module subroutine reset_params_wrf(self) Arguments Type Intent Optional Attributes Name class(type_wrf_params), intent(inout) :: self Source Code module subroutine reset_params_wrf ( self ) implicit none class ( type_wrf_params ), intent ( inout ) :: self self % unit_id = 0 self % model_number = 0 self % theta_s = 0.0d0 self % theta_r = 0.0d0 self % alpha1 = 0.0d0 self % n1 = 0.0d0 self % m1 = 0.0d0 self % h_crit = 0.0d0 self % alpha2 = 0.0d0 self % n2 = 0.0d0 self % m2 = 0.0d0 self % w1 = 0.0d0 self % w2 = 0.0d0 end subroutine reset_params_wrf","tags":"","url":"proc/reset_params_wrf.html"},{"title":"calculate_wrf_dvgch – FTDSS","text":"module subroutine calculate_wrf_dvgch(self, h, Qw) Arguments Type Intent Optional Attributes Name class(type_wrf_dvgch), intent(in) :: self real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: Qw Source Code module subroutine calculate_wrf_dvgch ( self , h , Qw ) implicit none class ( type_wrf_dvgch ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: Qw if ( h < 0.0d0 ) then Qw = self % params % theta_r + ( self % params % theta_s - self % params % theta_r ) * & ( self % params % w1 * ( 1.0d0 + abs ( self % params % alpha1 * h ) ** self % params % n1 ) ** ( - self % params % m1 ) & + self % params % w2 * ( 1.0d0 + abs ( self % params % alpha1 * h ) ** self % params % n2 ) ** ( - self % params % m2 )) else Qw = self % params % theta_s end if end subroutine calculate_wrf_dvgch","tags":"","url":"proc/calculate_wrf_dvgch.html"},{"title":"calculate_wrf_dvgch_derivative – FTDSS","text":"module subroutine calculate_wrf_dvgch_derivative(self, h, dQw_dh) Arguments Type Intent Optional Attributes Name class(type_wrf_dvgch), intent(in) :: self real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: dQw_dh Source Code module subroutine calculate_wrf_dvgch_derivative ( self , h , dQw_dh ) implicit none class ( type_wrf_dvgch ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: dQw_dh if ( h < 0.0d0 ) then dQw_dh = ( self % params % theta_s - self % params % theta_r ) * & ( self % params % w1 * self % params % alpha1 ** self % params % n1 * & self % params % m1 * self % params % n1 * ( - h ) ** ( self % params % n1 - 1.0d0 ) * & ( 1.0d0 + ( - self % params % alpha1 * h ) ** self % params % n1 ) ** ( - self % params % m1 - 1.0d0 ) & + self % params % w2 * self % params % alpha1 ** self % params % n2 * & self % params % m2 * self % params % n2 * ( - h ) ** ( self % params % n2 - 1.0d0 ) * & ( 1.0d0 + ( - self % params % alpha1 * h ) ** self % params % n2 ) ** ( - self % params % m2 - 1.0d0 )) else dQw_dh = 0.0d0 end if end subroutine calculate_wrf_dvgch_derivative","tags":"","url":"proc/calculate_wrf_dvgch_derivative.html"},{"title":"calc_thc_dispersivity_gp_1phase – FTDSS","text":"module subroutine calc_thc_dispersivity_gp_1phase(self, state, lambda) Interface → Arguments Type Intent Optional Attributes Name class( type_thc_1phase ), intent(in) :: self type( type_state ), intent(in) :: state type( type_thc_dispersivity