 Pw real ( real64 ), intent ( in ), optional :: rhoW real ( real64 ), intent ( in ), optional :: rhoI real ( real64 ) :: Suction if ( T <= self % Tf ) then Suction = - self % Lf * log (( T + self % TtoK ) / ( self % Tf + self % TtoK )) / self % g else Suction = 0.0d0 end if end function Calc_GCC_NonSeg_m module function Calc_GCC_NonSeg_m_Derivative ( self , T , Pw , rhoW , rhoI ) result ( Suction_Derivative ) implicit none class ( type_gcc_non_segregation_m ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T real ( real64 ), intent ( in ), optional :: Pw real ( real64 ), intent ( in ), optional :: rhoW real ( real64 ), intent ( in ), optional :: rhoI real ( real64 ) :: Suction_Derivative if ( T <= self % Tf ) then Suction_Derivative = - self % Lf / (( T + self % TtoK ) * self % g ) else Suction_Derivative = 0.0d0 end if end function Calc_GCC_NonSeg_m_Derivative module function Calc_GCC_NonSeg_m_Derivative_2nd ( self , T , Pw , rhoW , rhoI ) result ( Suction_Derivative ) implicit none class ( type_gcc_non_segregation_m ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T real ( real64 ), intent ( in ), optional :: Pw real ( real64 ), intent ( in ), optional :: rhoW real ( real64 ), intent ( in ), optional :: rhoI real ( real64 ) :: Suction_Derivative if ( T <= self % Tf ) then Suction_Derivative = self % Lf / (( T + self % TtoK ) ** 2.0d0 * self % g ) else Suction_Derivative = 0.0d0 end if end function Calc_GCC_NonSeg_m_Derivative_2nd end submodule gcc_non_segregation_m","tags":"","url":"sourcefile/gcc_non_segregation_m.f90.html"},{"title":"adjacency.F90 – FTDSS","text":"Source Code module domain_adjacency use :: domain_adjacency_adjacency_node , only : type_node_adjacency use :: domain_adjacency_adjacency_element , only : type_crs_adjacency_element implicit none end module domain_adjacency","tags":"","url":"sourcefile/adjacency.f90.html"},{"title":"HCF_Impedance.F90 – FTDSS","text":"Source Code submodule ( Calculate_HCF ) Calculate_HCF_Impedance_Imp