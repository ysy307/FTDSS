 ( bdf_coeffs ) drho_dt = 0.0d0 call local_state % copy ( state ) do j = 1 , n call local_state % temperature % set ( temperature_history ( j )) call local_state % pressure % set ( pressure_history ( j )) call self % update_water_phases ( material_id , local_state ) call local_state % water_content % get ( Qw ) call local_state % ice_content % get ( Qi ) call local_state % vapor_content % get ( Qv ) call self % physics % calc_density_water ( local_state , rho_w ) call self % physics % calc_density_ice ( local_state , rho_i ) ! Effective Density (Mass per unit volume) Uj = rho_w * Qw & + rho_i * Qi & + rho_w * Qv drho_dt = drho_dt + bdf_coeffs ( j ) * Uj end do end subroutine calc_effective_density_hydraulic","tags":"","url":"proc/calc_effective_density_hydraulic.html"},{"title":"compute_advective_term_hydraulic – FTDSS","text":"module subroutine compute_advective_term_hydraulic(self, material_id, state, V_H) Interface → @details\n  J_m_grav = V_H\n  J_m_grav = rho_w * (-K * grad z)\n  V_H = - rho_w * K * grad z Arguments Type Intent Optional Attributes Name class( type_hydraulic ), intent(in) :: self integer(kind=int32), intent(in) :: material_id type( type_state ), intent(inout) :: state real(kind=real64), intent(inout) :: V_H (:) Calls proc~~compute_advective_term_hydraulic~~CallsGraph proc~compute_advective_term_hydraulic compute_advective_term_hydraulic proc~calc_density_water type_physics_manager%calc_density_water proc~compute_advective_term_hydraulic->proc~calc_density_water proc~calc_kflh~2 type_physics_manager%calc_Kflh proc~compute_advective_term_hydraulic->proc~calc_kflh~2 proc~calc_rho_water_abst_physics abst_physics%calc_rho_water_abst_physics proc~calc_density_water->proc~calc_rho_water_abst_physics proc~calc_kflh type_models_manager%calc_Kflh proc~calc_kflh~2->proc~calc_kflh calc_Kflh calc_Kflh proc~calc_kflh->calc_Kflh calc_rho calc_rho proc~calc_rho_water_abst_physics->calc_rho proc~get_thermo_state_tp abst_physics%get_thermo_state_TP proc~calc_rho_