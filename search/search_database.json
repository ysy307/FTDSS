ords ( 1 , k ) y = node_coords ( 2 , k ) ! Row 1: x derivatives jac ( 1 , 1 ) = jac ( 1 , 1 ) + dpsi_xi * x ! dx/dxi jac ( 1 , 2 ) = jac ( 1 , 2 ) + dpsi_eta * x ! dx/deta (Was mixed in original) ! Row 2: y derivatives jac ( 2 , 1 ) = jac ( 2 , 1 ) + dpsi_xi * y ! dy/dxi jac ( 2 , 2 ) = jac ( 2 , 2 ) + dpsi_eta * y ! dy/deta end do end subroutine calc_jacobian_triangle_second","tags":"","url":"proc/calc_jacobian_triangle_second.html"},{"title":"calc_psi_triangle_second – FTDSS","text":"pure elemental module subroutine calc_psi_triangle_second(self, i, r, psi_val) Interface → Arguments Type Intent Optional Attributes Name class( type_triangle_second ), intent(in) :: self integer(kind=int32), intent(in) :: i type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(inout) :: psi_val Called by proc~~calc_psi_triangle_second~~CalledByGraph proc~calc_psi_triangle_second calc_psi_triangle_second interface~calc_psi_triangle_second type_triangle_second%calc_psi_triangle_second interface~calc_psi_triangle_second->proc~calc_psi_triangle_second proc~is_in_triangle_second is_in_triangle_second proc~is_in_triangle_second->interface~calc_psi_triangle_second interface~is_in_triangle_second type_triangle_second%is_in_triangle_second interface~is_in_triangle_second->proc~is_in_triangle_second Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure elemental module subroutine calc_psi_triangle_second ( self , i , r , psi_val ) implicit none class ( type_triangle_second ), intent ( in ) :: self integer ( int32 ), intent ( in ) :: i type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( inout ) :: psi_val real ( real64 ) :: L1 real ( real64 ) :: L2 real ( real64 ) :: L3 L1 = 1.0d0 - r % x - r % y L2 = r % x L3 = r % y select case ( i ) case ( 1 ) ! Corner 1 psi_val = L1 * ( 2.0d0 * L1 - 1.0d0 ) case ( 2 ) ! Corner 2 psi_val = L2 * ( 2.0d0 * L2 - 1.0d0 ) case ( 3 ) ! Corner 3 psi_val = L3 * ( 2.0d0 * L3 - 1.0d0 ) case ( 4 ) ! Mid 1-2 psi_val = 4.0d0 * L1 * L2 case ( 5 ) ! Mid 2-3 psi_val = 4.0d0 * L2 * L3 case ( 6 ) ! Mid 3-1 psi_val = 4.0d0 * L3 * L1 case default psi_val = 0.0d0 end select end subroutine calc_psi_triangle_second","tags":"","url":"proc/calc_psi_triangle_second.html"},{"title":"is_in_triangle_second – FTDSS","text":"module subroutine is_in_triangle_second(self, cartesian, normalized, node_coords, is_in) Interface → Arguments Type Intent Optional Attributes Name class( type_triangle_second ), intent(in) :: self type( type_coordinate_dp ), intent(in) :: cartesian type( type_coordinate_dp ), intent(inout) :: normalized real(kind=real64), intent(in) :: node_coords (:,:) logical, intent(inout) :: is_in Calls proc~~is_in_triangle_second~~CallsGraph proc~is_in_triangle_second is_in_triangle_second interface~calc_jacobian_determinant_abst_fe abst_fe%calc_jacobian_determinant_abst_fe proc~is_in_triangle_second->interface~calc_jacobian_determinant_abst_fe interface~calc_jacobian_triangle_second type_triangle_second%calc_jacobian_triangle_second proc~is_in_triangle_second->interface~calc_jacobian_triangle_second interface~calc_psi_triangle_second type_triangle_second%calc_psi_triangle_second proc~is_in_triangle_second->interface~calc_psi_triangle_second interface~get_num_nodes abst_fe%get_num_nodes proc~is_in_triangle_second->interface~get_num_nodes none~set~12 type_coordinate_dp