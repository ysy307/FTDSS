le. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure module subroutine calc_jacobian_square_second ( self , r , node_coords , jac ) implicit none class ( type_square_second ), intent ( in ) :: self type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( in ) :: node_coords (:, :) real ( real64 ), intent ( inout ) :: jac (:, :) integer ( int32 ) :: k real ( real64 ) :: dpsi_xi real ( real64 ) :: dpsi_eta real ( real64 ) :: xk , yk jac = 0.0d0 do k = 1 , 8 call self % calc_dpsi ( k , 1 , r , dpsi_xi ) call self % calc_dpsi ( k , 2 , r , dpsi_eta ) xk = node_coords ( 1 , k ) yk = node_coords ( 2 , k ) ! dpsi_xi contributes to derivatives w.r.t xi (Col 1) jac ( 1 , 1 ) = jac ( 1 , 1 ) + dpsi_xi * xk ! dx/dxi jac ( 2 , 1 ) = jac ( 2 , 1 ) + dpsi_xi * yk ! dy/dxi (was mixed in original) ! dpsi_eta contributes to derivatives w.r.t eta (Col 2) jac ( 1 , 2 ) = jac ( 1 , 2 ) + dpsi_eta * xk ! dx/deta (was mixed in original) jac ( 2 , 2 ) = jac ( 2 , 2 ) + dpsi_eta * yk ! dy/deta end do end subroutine calc_jacobian_square_second","tags":"","url":"proc/calc_jacobian_square_second.html"},{"title":"calc_psi_square_second – FTDSS","text":"pure elemental module subroutine calc_psi_square_second(self, i, r, psi_val) Interface → Arguments Type Intent Optional Attributes Name class( type_square_second ), intent(in) :: self integer(kind=int32), intent(in) :: i type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(inout) :: psi_val Called by proc~~calc_psi_square_second~~CalledByGraph proc~calc_psi_square_second calc_psi_square_second interface~calc_psi_square_second type_square_second%calc_psi_square_second interface~calc_psi_square_second->proc~calc_psi_square_second proc~is_in_square_second is_in_square_second proc~is_in_square_second->interface~calc_psi_square_second interface~is_in_square_second type_square_second%is_in_square_second interface~is_in_square_seco