TS_DATATYPE = c_short case ( c_unsigned_int ) vtk % POINTS_DATATYPE = c_unsigned_int case ( c_int ) vtk % POINTS_DATATYPE = c_int case ( c_unsigned_long ) vtk % POINTS_DATATYPE = c_unsigned_long case ( c_long ) vtk % POINTS_DATATYPE = c_long case ( c_float ) vtk % POINTS_DATATYPE = c_float case ( c_double ) vtk % POINTS_DATATYPE = c_double end select call vtk % POINTS % allocate ( numPoints ) do iPoint = 1 , vtk % numPoints read ( unit , * , iostat = iostat ) vtk % POINTS % x ( iPoint ), vtk % POINTS % y ( iPoint ), vtk % POINTS % z ( iPoint ) if ( iostat /= 0 ) stop end do read ( unit , '(a)' , iostat = iostat ) ! Skip end subroutine Core_VTK_Read_Data_Points","tags":"","url":"proc/core_vtk_read_data_points.html"},{"title":"Core_VTK_Read_Data_Cells – FTDSS","text":"private  subroutine Core_VTK_Read_Data_Cells(unit, vtk, headline) Read VTK data cells Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: unit Unit number type( Type_VTK ), intent(inout) :: vtk VTK data character(len=*), intent(in) :: headline Headline Calls proc~~core_vtk_read_data_cells~~CallsGraph proc~core_vtk_read_data_cells Core_VTK_Read_Data_Cells interface~allocate_array Allocate_Array proc~core_vtk_read_data_cells->interface~allocate_array proc~allocate_rank1_int16 Allocate_Rank1_int16 interface~allocate_array->proc~allocate_rank1_int16 proc~allocate_rank1_int32 Allocate_Rank1_int32 interface~allocate_array->proc~allocate_rank1_int32 proc~allocate_rank1_int32_pointer Allocate_Rank1_int32_Pointer interface~allocate_array->proc~allocate_rank1_int32_pointer proc~allocate_rank1_int32_specify Allocate_Rank1_int32_specify interface~allocate_array->proc~allocate_rank1_int32_specify proc~allocate_rank1_int32_specify_pointer Allocate_Rank1_int32_specify_Pointer interface~allocate_array->proc~allocate_rank1_int32_specify_pointer proc~allocate_rank1_int64 Allocate_Rank1_int64 interface~allocate_array->proc~allocate_rank1_int64 proc~allocate_rank1_int64_pointer Allocate_Rank1_i