Si ) call json % print_error_message ( output_unit ) key = Connect_dot ( OutputSettingsName , KindsName , TCName ) call json % get ( key , self % OutputSettings % outTC ) call json % print_error_message ( output_unit ) key = Connect_dot ( OutputSettingsName , KindsName , CName ) call json % get ( key , self % OutputSettings % outC ) call json % print_error_message ( output_unit ) key = Connect_dot ( OutputSettingsName , KindsName , PresName ) call json % get ( key , self % OutputSettings % outPres ) call json % print_error_message ( output_unit ) key = Connect_dot ( OutputSettingsName , KindsName , FluxName ) call json % get ( key , self % OutputSettings % outFlux ) call json % print_error_message ( output_unit ) key = Connect_dot ( OutputSettingsName , KindsName , KName ) call json % get ( key , self % OutputSettings % outK ) call json % print_error_message ( output_unit ) end subroutine Inout_Input_OutputSettings_JSON","tags":"","url":"proc/inout_input_outputsettings_json.html"},{"title":"Type_Input – FTDSS","text":"public interface Type_Input Calls interface~~type_input~~CallsGraph interface~type_input Type_Input proc~input_constructor Input_Constructor interface~type_input->proc~input_constructor proc~error_message error_message proc~input_constructor->proc~error_message proc~inout_input_conditions_json Type_Input%Inout_Input_Conditions_JSON proc~input_constructor->proc~inout_input_conditions_json proc~inout_input_geometry_vtk Type_Input%Inout_Input_Geometry_VTK proc~input_constructor->proc~inout_input_geometry_vtk proc~inout_input_parameters_json Type_Input%Inout_Input_Parameters_JSON proc~input_constructor->proc~inout_input_parameters_json proc~inout_projectpath_getprojectpath Inout_ProjectPath_GetProjectPath proc~input_constructor->proc~inout_projectpath_getprojectpath destroy destroy proc~inout_input_conditions_json->destroy initialize initialize proc~inout_input_conditions_json->initialize load load proc~inout_input_conditions_json->load print_error_message