bc ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: Qw if ( h < self % params % alpha1 ) then Qw = self % params % theta_r + ( self % params % theta_s - self % params % theta_r ) * ( self % params % alpha1 / h ) ** self % params % n1 else Qw = self % params % theta_s end if end subroutine calculate_wrf_bc","tags":"","url":"proc/calculate_wrf_bc.html"},{"title":"calculate_wrf_bc_derivative – FTDSS","text":"module subroutine calculate_wrf_bc_derivative(self, h, dQw_dh) Arguments Type Intent Optional Attributes Name class(type_wrf_bc), intent(in) :: self real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: dQw_dh Source Code module subroutine calculate_wrf_bc_derivative ( self , h , dQw_dh ) implicit none class ( type_wrf_bc ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: dQw_dh !@note alpha1 must be negative if ( h < self % params % alpha1 ) then dQw_dh = - ( self % params % theta_s - self % params % theta_r ) * self % params % n1 & * ( self % params % alpha1 / h ) ** ( self % params % n1 + 1.0d0 ) / self % params % alpha1 else dQw_dh = 0.0d0 end if end subroutine calculate_wrf_bc_derivative","tags":"","url":"proc/calculate_wrf_bc_derivative.html"},{"title":"apply_preconditioner_none – FTDSS","text":"module subroutine apply_preconditioner_none(self, r, z) Interface → Arguments Type Intent Optional Attributes Name class( type_preconditioner_none ), intent(inout) :: self type( type_vector_dp ), intent(in) :: r type( type_vector_dp ), intent(inout) :: z Calls proc~~apply_preconditioner_none~~CallsGraph proc~apply_preconditioner_none apply_preconditioner_none interface~copy_vector_dp type_vector_dp%copy_vector_dp proc~apply_preconditioner_none->interface~copy_vector_dp proc~copy_vector_dp copy_vector_dp interface~copy_vector_dp->proc~copy_vector_dp interface~destroy_vector_dp type_vector_dp%destroy_vector_dp proc~copy_vector_dp->interface~destroy_vector_dp 