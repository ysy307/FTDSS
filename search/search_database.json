 interface~calc_area_triangle_first type_triangle_first%calc_area_triangle_first interface~calc_area_triangle_first->proc~calc_area_triangle_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine calc_area_triangle_first ( self , node_coords , measure ) implicit none class ( type_triangle_first ), intent ( in ) :: self real ( real64 ), intent ( in ) :: node_coords (:, :) real ( real64 ), intent ( inout ) :: measure real ( real64 ) :: x ( 3 ) real ( real64 ) :: y ( 3 ) integer ( int32 ) :: i do i = 1 , 3 x ( i ) = node_coords ( 1 , i ) y ( i ) = node_coords ( 2 , i ) end do ! Area = 0.5 * |x1(y2-y3) + x2(y3-y1) + x3(y1-y2)| measure = 0.5d0 * abs ( x ( 1 ) * ( y ( 2 ) - y ( 3 )) + x ( 2 ) * ( y ( 3 ) - y ( 1 )) + x ( 3 ) * ( y ( 1 ) - y ( 2 ))) end subroutine calc_area_triangle_first","tags":"","url":"proc/calc_area_triangle_first.html"},{"title":"calc_dpsi_triangle_first – FTDSS","text":"pure elemental module subroutine calc_dpsi_triangle_first(self, i, j, r, dpsi_val) Interface → Evaluates the derivative of the shape function dpsi. Arguments Type Intent Optional Attributes Name class( type_triangle_first ), intent(in) :: self integer(kind=int32), intent(in) :: i integer(kind=int32), intent(in) :: j type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(inout) :: dpsi_val Called by proc~~calc_dpsi_triangle_first~~CalledByGraph proc~calc_dpsi_triangle_first calc_dpsi_triangle_first interface~calc_dpsi_triangle_first type_triangle_first%calc_dpsi_triangle_first interface~calc_dpsi_triangle_first->proc~calc_dpsi_triangle_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure elemental module subroutine calc_dpsi_triangle_first ( self , i , j , r , dpsi_val ) implicit none class ( type_triangle_first ), intent ( in ) :: self integer ( int32 ), intent ( in ) :: i integer ( int32 ), intent ( in ) :: j type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( inout ) :: dpsi_val dpsi_val = 0.0d0 select case ( i ) case ( 1 ) if ( j == 1 ) dpsi_val = - 1.0d0 if ( j == 2 ) dpsi_val = - 1.0d0 case ( 2 ) if ( j == 1 ) dpsi_val = 1.0d0 case ( 3 ) if ( j == 2 ) dpsi_val = 1.0d0 end select end subroutine calc_dpsi_triangle_first","tags":"","url":"proc/calc_dpsi_triangle_first.html"},{"title":"calc_jacobian_triangle_first – FTDSS","text":"pure module subroutine calc_jacobian_triangle_first(self, r, node_coords, jac) Interface → Calculates the Jacobian matrix.\nStandard definition: J(i, j) = d(x_i) / d(xi_j) Arguments Type Intent Optional Attributes Name class( type_triangle_first ), intent(in) :: self type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(in) :: node_coords (:,:) real(kind=real64), intent(inout) :: jac (:,:) Called by proc~~calc_jacobian_triangle_first~~CalledByGraph proc~calc_jacobian_triangle_first calc_jacobian_triangle_first interface~calc_jacobian_triangle_first type_triangle_first%calc_jacobian_triangle_first interface~calc_jacobian_triangle_first->proc~calc_jacobian_triangle_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure module subroutine calc_jacobian_triangle_first ( self , r , node_coords , jac ) implicit none class ( type_triangle_first ), intent ( in ) :: self type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( in ) :: node_coords (:, :) real ( real64 ), intent ( inout ) :: jac (:, :) real ( real64 ) :: x ( 3 ) real ( real64 ) :: y ( 3 ) integer ( int32 ) :: k do k = 1 , 3 x ( k ) = node_coords ( 1 , k ) y ( k ) = node_coords ( 2 , k ) end do jac = 0.0d0 ! Row 1: dx/dxi, dx/deta jac ( 1 , 1 ) = x ( 2 ) - x ( 1 ) jac ( 1 , 2 ) = x ( 3 ) - x ( 1 ) ! Fixed: Was y(2)-y(1) in previous/implicit logic ! Row 2: dy/dxi, dy/deta jac ( 2 , 1 ) = y ( 2 ) - y ( 1 ) ! Fixed: Was x(3)-x(1) in previous/implicit logic jac ( 2 , 2 ) = y ( 3 ) - y ( 1 ) end subroutine calc_jacobian_triangle_first","tags":"","url":"proc/calc_jacobian_triangle_first.html"},{"title":"calc_psi_triangle_first – FTDSS","text":"pure elemental module subroutine calc_psi_triangle_first(self, i, r, psi_val) Interface → Evaluates the shape function psi. Arguments Type Intent Optional Attributes Name class( type_triangle_first ), intent(in) :: self integer(kind=int32), intent(in) :: i type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(inout) :: psi_val Called by proc~~calc_psi_triangle_first~~CalledByGraph proc~calc_psi_triangle_first calc_psi_triangle_first interface~calc_psi_triangle_first type_triangle_first%calc_psi_triangle_first interface~calc_psi_triangle_first->proc~calc_psi_triangle_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure elemental module subroutine calc_psi_triangle_first ( self , i , r , psi_val ) implicit none class ( type_triangle_first ), intent ( in ) :: self integer ( int32 ), intent ( in ) :: i type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( inout ) :: psi_val select case ( i ) case ( 1 ) psi_val = 1.0d0 - r % x - r % y case ( 2 ) psi_val = r % x case ( 3 ) psi_val = r % y case default psi_val = 0.0d0 end select end subroutine calc_psi_triangle_first","tags":"","url":"proc/calc_psi_triangle_first.html"},{"title":"is_in_triangle_first – FTDSS","text":"module subroutine is_in_triangle_first(self, cartesian, normalized, node_coords, is_in) Interface → Checks if point is inside using analytical Barycentric coordinates. Arguments Type Intent Optional Attributes Name class( type_triangle_first ), intent(in) :: self type( type_coordinate_dp ), intent(in) :: cartesian type( type_coordinate_dp ), intent(inout) :: normalized real(kind=real64), intent(in) :: node_coords (:,:) logical, intent(inout) :: is_in Calls proc~~is_in_triangle_first~~CallsGraph proc~is_in_triangle_first is_in_triangle_first none~set~12 type_coordinate_dp%set proc~is_in_triangle_first->none~set~12 proc~set_coordinate_dp type_coordinate_dp%set_coordinate_dp none~set~12->proc~set_coordinate_dp proc~set_coordinate_dp_array type_coordinate_dp%set_coordinate_dp_array none~set~12->proc~set_coordinate_dp_array Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~is_in_triangle_first~~CalledByGraph proc~is_in_triangle_first is_in_triangle_first interface~is_in_triangle_first type_triangle_first%is_in_triangle_first interface~is_in_triangle_first->proc~is_in_triangle_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine is_in_triangle_first ( self , cartesian , normalized , node_coords , is_in ) implicit none class ( type_triangle_first ), intent ( in ) :: self type ( type_coordinate_dp ), intent ( in ) :: cartesian type ( type_coordinate_dp ), intent ( inout ) :: normalized real ( real64 ), intent ( in ) :: node_coords (:, :) logical , intent ( inout ) :: is_in real ( real64 ) :: x ( 3 ) real ( real64 ) :: y ( 3 ) real ( real64 ) :: det_T real ( real64 ) :: dx real ( real64 ) :: dy real ( real64 ) :: xi real ( real64 ) :: eta integer ( int32 ) :: i real ( real64 ), parameter :: tol = 1.0e-9 do i = 1 , 3 x ( i ) = node_coords ( 1 , i ) y ( i ) = node_coords ( 2 , i ) end do det_T = ( x ( 2 ) - x ( 1 )) * ( y ( 3 ) - y ( 1 )) - ( x ( 3 ) - x ( 1 )) * ( y ( 2 ) - y ( 1 )) if ( abs ( det_T ) < epsilon ( det_T )) then is_in = . false . return end if dx = cartesian % x - x ( 1 ) dy = cartesian % y - y ( 1 ) ! Solving linear system for barycentric coords xi = (( y ( 3 ) - y ( 1 )) * dx - ( x ( 3 ) - x ( 1 )) * dy ) / det_T eta = ( - ( y ( 2 ) - y ( 1 )) * dx + ( x ( 2 ) - x ( 1 )) * dy ) / det_T is_in = ( xi >= - tol ) . and . ( eta >= - tol ) . and . ( xi + eta <= 1.0d0 + tol ) if ( is_in ) then call normalized % set ( xi , eta , 0.0d0 ) end if end subroutine is_in_triangle_first","tags":"","url":"proc/is_in_triangle_first.html"},{"title":"apply_uniform – FTDSS","text":"module subroutine apply_uniform(self, variable) Interface → Arguments Type Intent Optional Attributes Name class( type_ic_uniform ), intent(in) :: self type(type_variable), intent(inout) :: variable Calls proc~~apply_uniform~~CallsGraph proc~apply_uniform apply_uniform set_current set_current proc~apply_uniform->set_current set_previous set_previous proc~apply_uniform->set_previous He