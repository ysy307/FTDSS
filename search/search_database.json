ent(in) :: file_format real(kind=real64), intent(in) :: current_time integer(kind=int32), intent(in), optional :: initial_step Calls proc~~initialize_manager~~CallsGraph proc~initialize_manager type_output_manager%initialize_manager optval optval proc~initialize_manager->optval strip strip proc~initialize_manager->strip to_object to_object proc~initialize_manager->to_object Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine initialize_manager ( self , interval_val , interval_unit_id , output_unit_id , & file_format , current_time , initial_step ) implicit none class ( type_output_manager ), intent ( inout ) :: self real ( real64 ), intent ( in ) :: interval_val integer ( int32 ), intent ( in ) :: interval_unit_id integer ( int32 ), intent ( in ) :: output_unit_id character ( * ), intent ( in ) :: file_format real ( real64 ), intent ( in ) :: current_time integer ( int32 ), intent ( in ), optional :: initial_step type ( type_constant_value ) :: interval_time_unit if ( strip ( file_format ) == \"none\" ) then self % is_active = . false . return end if self % is_active = . true . ! 1. 間隔を「秒」に変換して保存 interval_time_unit = TIME_UNITS % to_object ( interval_unit_id ) self % interval_seconds = interval_val * interval_time_unit % value ! 2. 出力単位オブジェクトを保存（表示・変換用） self % output_time_unit = TIME_UNITS % to_object ( output_unit_id ) ! 3. 次回出力時刻を「秒」で設定 self % next_output_seconds = current_time self % current_step = optval ( initial_step , 0 ) end subroutine initialize_manager","tags":"","url":"proc/initialize_manager.html"},{"title":"update_state – FTDSS","text":"private  subroutine update_state(self, current_time_seconds) Type Bound type_output_manager Arguments Type Intent Optional Attributes Name class( type_output_manager ), intent(inout) :: self real(kind=real64), intent(in) :: current_time_seconds Called by proc~~update_state~~CalledByGraph proc~update_state type_output_manager%update_state proc~output_fields_ftdss output_fields_ftdss proc~output_fields_ftdss->proc~update_state proc~output_history_ftdss output_history_ftdss proc~output_history_ftdss->proc~update_state interface~output_fields_ftdss type_ftdss%output_fields_ftdss interface~output_fields_ftdss->proc~output_fields_ftdss interface~output_history_ftdss type_ftdss%output_history_ftdss interface~output_history_ftdss->proc~output_history_ftdss proc~initialize_type_ftdss initialize_type_ftdss proc~initialize_type_ftdss->interface~output_fields_ftdss proc~initialize_type_ftdss->interface~output_history_ftdss proc~run_ftdss run_ftdss proc~run_ftdss->interface~output_fields_ftdss proc~run_ftdss->interface~output_history_ftdss interface~initialize_type_ftdss type_ftdss%initialize_type_ftdss interface~initialize_type_ftdss->proc~initialize_type_ftdss interface~run_ftdss type_ftdss%run_ftdss interface~run_ftdss->proc~run_ftdss Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine update_state ( self , current_time_seconds ) implicit none class ( type_output_manager ), intent ( inout ) :: self real ( real64 ), intent ( in ) :: current_time_seconds real ( real64 ), parameter :: tolerance = 1.0d-9 real ( real64 ) :: diff , steps_to_add if (. not . self % is_active ) return if ( self % next_output_seconds <= current_time_seconds + tolerance ) then diff = ( current_time_seconds + tolerance ) - self % next_output_seconds if ( self % interval_seconds > 0.0d0 ) then steps_to_add = floor ( diff / self % interval_seconds ) + 1.0d0 self % next_output_seconds = self % next_output_seconds + steps_to_add * self % interval_seconds end if end if self % current_step = self % current_step + 1 end subroutine update_state","tags":"","url":"proc/update_state.html"},{"title":"display_material_basic – FTDSS","text":"subroutine display_material_basic(material) Arguments Type Intent Optional Attributes Name class( type_material_settings ), intent(in) :: material Calls proc~~display_material_basic~~CallsGraph proc~display_material_basic display_material_basic proc~get_physics_type get_physics_type proc~display_material_basic->proc~get_physics_type strip strip proc~get_physics_type->strip to_lower to_lower proc~get_physics_type->to_lower Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~display_material_basic~~CalledByGraph proc~display_material_basic display_material_basic proc~display_material_settings display_material_settings proc~display_material_settings->proc~display_material_basic interface~display_material_settings type_material_settings%display_material_settings interface~display_material_settings->proc~display_material_settings Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine display_material_basic ( material ) implicit none class ( type_material_settings ), intent ( in ) :: material write ( * , '(a, i0)' ) \"  ID                  : \" , material % id if ( allocated ( material % name )) then write ( * , '(a, a)' ) \"  Name                : \" , trim ( material % name ) end if write ( * , '(a, i0)' ) \"  Phase Count         : \" , material % phase ! is_frozen 等のフラグが構造体にない場合は削除，ある場合は復活させてください ! write (*, '(a, g0)') \"  Is Frozen           : \", material%is_frozen write ( * , '(a, L1)' ) \"  Calculate Thermal   : \" , material % is_active ( get_physics_type ( thermal )) write ( * , '(a, L1)' ) \"  Calculate Hydraulic : \" , material % is_active ( get_physics_type ( hydraulic )) write ( * , '(a, L1)' ) \"  Calculate Mechanical: \" , material % is_active ( get_physics_type ( mechanical )) end subroutine display_material_basic","tags":"","url":"proc/display_material_basic.html"},{"title":"display_material_hydraulic – FTDSS","text":"subroutine display_material_hydraulic(material) Arguments Type Intent Optional Attributes Name class( type_material_settings ), intent(in) :: material Calls proc~~display_material_hydraulic~~CallsGraph proc~display_material_hydraulic display_material_hydraulic proc~display_wcc display_wcc proc~display_material_hydraulic->proc~display_wcc proc~get_physics_unit_string get_physics_unit_string proc~display_wcc->proc~get_physics_unit_string proc~get_swcc_model_type_string get_swcc_model_type_string proc~display_wcc->proc~get_swcc_model_type_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~display_material_hydraulic~~CalledByGraph proc~display_material_hydraulic display_material_hydraulic proc~display_material_settings display_material_settings proc~display_material_settings->proc~display_material_hydraulic interface~display_material_settings type_material_settings%display_material_settings interface~display_material_settings->proc~display_material_settings Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine display_material_hydraulic ( material ) implicit none class ( type_material_settings ), intent ( in ) :: material write ( * , '(a)' ) \"  --- Hydraulic Properties ---\" ! Hydraulic Conductivity write ( * , '(a, i0)' ) \"    HC Model Number     : \" , material % hydraulic_conductivity_model % model_number write ( * , '(a, es12.4e2)' ) \"    Saturated K         : \" , material % hydraulic_conductivity_model % saturated_conductivity write ( * , '(a, es12.4e2)' ) \"    Impedance Factor    : \" , material % hydraulic_conductivity_model % impedance_factor write ( * , '(a, i0)' ) \"    Viscosity Model #   : \" , material % hydraulic_conductivity_model % water_viscosity_model write ( * , '(a, es12.4e2)' ) \"    Gain Factor         : \" , material % hydraulic_conductivity_model % gain_factor ! Water Retention Model (WCC) call display_wcc ( material % water_characteristic_curve ) end subroutine display_material_hydraulic","tags":"","url":"proc/display_material_hydraulic.html"},{"title":"display_material_thermal – FTDSS","text":"subroutine display_material_thermal(material) Arguments Type Intent Optional Attributes Name class( type_material_settings ), intent(in) :: material Calls proc~~display_material_thermal~~CallsGraph proc~display_material_thermal display_material_thermal to_string to_string proc~display_material_thermal->to_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound