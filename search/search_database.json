r ), intent ( inout ), optional :: propeties real ( real64 ), intent ( in ), optional :: porosity (:) real ( real64 ), intent ( in ), optional :: temperature (:) real ( real64 ), intent ( in ), optional :: pressure (:) real ( real64 ) :: obsValues ( 3 * size ( self % observations )) integer ( int32 ) :: iObs do iObs = 1 , size ( self % observations ) if (. not . self % observations ( iObs )% do_output ) cycle if ( self % is_thermal . and . self % is_hydraulic ) then call self % observations ( iObs )% get_values ( obs_values = obsValues , & nodal_temperature = temperature , & nodal_porosity = porosity , & nodal_pw = pressure , & properties = propeties , & domain = domain ) else if ( self % is_thermal ) then call self % observations ( iObs )% get_values ( obs_values = obsValues , & nodal_temperature = temperature , & nodal_porosity = porosity , & properties = propeties , & domain = domain ) else if ( self % is_hydraulic ) then call self % observations ( iObs )% get_values ( obs_values = obsValues , & nodal_pw = pressure , & nodal_porosity = porosity , & properties = propeties , & domain = domain ) end if call self % observations ( iObs )% write_line ( & unit = self % observations ( iObs )% num_unit , & time = time , & values = obsValues ) end do end subroutine output_history end module input_output","tags":"","url":"sourcefile/output_interface.f90.html"},{"title":"system_info.F90 – FTDSS","text":"Files dependent on this one sourcefile~~system_info.f90~~AfferentGraph sourcefile~system_info.f90 system_info.F90 sourcefile~c_utils.f90 c_utils.F90 sourcefile~c_utils.f90->sourcefile~system_info.f90 sourcefile~memory_stats_wrapper.f90 memory_stats_wrapper.F90 sourcefile~memory_stats_wrapper.f90->sourcefile~c_utils.f90 sourcefile~system_info_wrapper.f90 system_info_wrapper.F90 sourcefile~system_info_wrapper.f90->sourcefile~c_utils.f90 sourcefile~fortran_utils.f90 fortran_utils.F90 sourcefile~fortran_utils.f90->sourcefile~memory_stats_wrapper.f90 sourcefile~fortran_utils.f90->