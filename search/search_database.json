ke them easier to distinguish in\nlarge graphs. Source Code subroutine ensure_buffers_ready ( self , required_send_size , required_recv_size , num_components ) class ( type_halo_communicator ), intent ( inout ) :: self integer ( int32 ), intent ( in ) :: required_send_size , required_recv_size integer ( int32 ), intent ( in ), optional :: num_components if (. not . allocated ( self % send_buf ) . or . size ( self % send_buf ) < required_send_size ) then call deallocate_array ( self % send_buf ) allocate ( self % send_buf ( max ( 0 , required_send_size ))) end if if (. not . allocated ( self % recv_buf ) . or . size ( self % recv_buf ) < required_recv_size ) then call deallocate_array ( self % recv_buf ) allocate ( self % recv_buf ( max ( 0 , required_recv_size ))) end if if ( present ( num_components ) . and . self % num_partners > 0 ) then if (. not . allocated ( self % send_counts_vector )) then allocate ( self % send_counts_vector ( self % num_partners )) allocate ( self % send_displs_vector ( self % num_partners )) allocate ( self % recv_counts_vector ( self % num_partners )) allocate ( self % recv_displs_vector ( self % num_partners )) end if self % send_counts_vector = self % send_counts * num_components self % send_displs_vector = self % send_displs * num_components self % recv_counts_vector = self % recv_counts * num_components self % recv_displs_vector = self % recv_displs * num_components end if end subroutine ensure_buffers_ready","tags":"","url":"proc/ensure_buffers_ready.html"},{"title":"exchange_and_operate_scalar_impl – FTDSS","text":"private  subroutine exchange_and_operate_scalar_impl(self, data_array, operation) Type Bound type_halo_communicator Arguments Type Intent Optional Attributes Name class( type_halo_communicator ), intent(inout) :: self real(kind=real64), intent(inout) :: data_array (:) integer(kind=int32), intent(in) :: operation Calls proc~~exchange_and_operate_scalar_impl~~CallsGraph proc~exchange_and_operate_scalar_impl type_halo_commu