\"Error in apply_bsr_ilu0: Vector size (\" , size ( x ), & \") does not match Preconditioner Matrix size (\" , self % num_rows * bs , \")\" self % status = - 1 return end if ! ------------------------- ! 前進代入 do i = 1 , self % num_rows idx_i = ( i - 1 ) * bs + 1 do k = self % ptr ( i ), self % diag_ptr ( i ) - 1 col = self % ind ( k ) idx_c = ( col - 1 ) * bs + 1 call dgemv ( 'N' , bs , bs , - 1.0d0 , & self % val_blocks (:, :, k ), bs , & x ( idx_c ), 1 , 1.0d0 , & x ( idx_i ), 1 ) end do end do ! 後退代入 do i = self % num_rows , 1 , - 1 idx_i = ( i - 1 ) * bs + 1 do k = self % diag_ptr ( i ) + 1 , self % ptr ( i + 1 ) - 1 col = self % ind ( k ) idx_c = ( col - 1 ) * bs + 1 call dgemv ( 'N' , bs , bs , - 1.0d0 , & self % val_blocks (:, :, k ), bs , & x ( idx_c ), 1 , 1.0d0 , & x ( idx_i ), 1 ) end do call dgetrs ( 'N' , bs , 1 , & self % val_blocks (:, :, self % diag_ptr ( i )), bs , & self % diag_pivots (:, i ), & x ( idx_i ), bs , ierr ) end do end subroutine apply_bsr_ilu0","tags":"","url":"proc/apply_bsr_ilu0.html"},{"title":"apply_csr_ilu0 – FTDSS","text":"module subroutine apply_csr_ilu0(self, r, z) Interface → スカラ ILU(0) 適用 (CSR) Arguments Type Intent Optional Attributes Name class( type_preconditioner_iluk ), intent(inout) :: self type( type_vector_dp ), intent(in) :: r type( type_vector_dp ), intent(inout) :: z Calls proc~~apply_csr_ilu0~~CallsGraph proc~apply_csr_ilu0 apply_csr_ilu0 interface~copy_vector_dp type_vector_dp%copy_vector_dp proc~apply_csr_ilu0->interface~copy_vector_dp interface~get_data_vector_dp type_vector_dp%get_data_vector_dp proc~apply_csr_ilu0->interface~get_data_vector_dp proc~copy_vector_dp copy_vector_dp interface~copy_vector_dp->proc~copy_vector_dp proc~get_data_vector_dp get_data_vector_dp interface~get_data_vector_dp->proc~get_data_vector_dp interface~destroy_vector_dp type_vector_dp%destroy_vector_dp proc~copy_vector_dp->interface~destroy_vector_dp interface~initialize_vector_dp type_vector_dp%initialize_vector_dp proc~copy_vector_