e' , action = 'write' ) write ( num_unit , '(a)' ) \"# \" // trim ( data_label ) // \" time variation\" write ( num_unit , '(a)' ) \"#\" select case ( self % Observation % ObservationType ) case ( 1 ) write ( num_unit , '(a)' ) \"# Observation Node ID\" do iObs = 1 , nObs write ( num_unit , '(a,i0,a,x,i0)' ) \"# Node ID \" , iObs , \":\" , self % Observation % ObsNodeID ( iObs ) end do case ( 2 ) write ( num_unit , '(a)' ) \"# Observation Coordinate (x,y,z)\" ! print *, self%Observation%Element(iObs)%e%ElementID ! stop do iObs = 1 , nObs write ( num_unit , '(a,x,i0,a,3(x,es18.11,a),a,i0)' ) & \"#    Point\" , iObs , \": (\" , & self % Observation % Cood_Obs % x ( iObs ), \",\" , & self % Observation % Cood_Obs % y ( iObs ), \",\" , & self % Observation % Cood_Obs % z ( iObs ), \")\" , & \" => Element ID: \" , & self % Observation % Element ( iObs )% e % ElementID end do end select write ( num_unit , '(a)' ) \"#\" write ( num_unit , '(a)' ) \"# Output Unit: Time [\" // trim ( adjustl ( self % Output_TimeUnit )) // \"], \" // trim ( data_label ) // \" [\" // trim ( var_unit ) // \"]\" write ( num_unit , '(a)' ) \"#\" write ( num_unit , '(a,' // to_string ( nObs ) // '(2x,a))' ) \"Time\" , ( \"Obs\" // to_string ( iObs ), iObs = 1 , nObs ) end subroutine Write_Observation_Header","tags":"","url":"proc/write_observation_header.html"},{"title":"Initialize_Observation_Header – FTDSS","text":"module subroutine Initialize_Observation_Header(self, data_name) Interface → Arguments Type Intent Optional Attributes Name class( Type_Output ) :: self character(len=*), intent(in) :: data_name Calls proc~~initialize_observation_header~~CallsGraph proc~initialize_observation_header Initialize_Observation_Header interface~write_observation_header Type_Output%Write_Observation_Header proc~initialize_observation_header->interface~write_observation_header proc~write_observation_header Write_Observation_Header interface~write_observation_header->proc~write_observation_header to_string to_