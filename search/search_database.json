e_history ( j )) call local_state % porosity % set ( porosity_history ( j )) call self % update_water_phases ( material_id , local_state ) call self % calc_enthalpy_density ( material_id , local_state , Uj ) dU_dt = dU_dt + bdf_coeffs ( j ) * Uj end do end subroutine compute_transient_term_thermal","tags":"","url":"proc/compute_transient_term_thermal.html"},{"title":"update_water_phases_thermal – FTDSS","text":"module subroutine update_water_phases_thermal(self, material_id, state) Interface → Arguments Type Intent Optional Attributes Name class( type_thermal ), intent(in) :: self integer(kind=int32), intent(in) :: material_id type( type_state ), intent(inout) :: state Calls proc~~update_water_phases_thermal~~CallsGraph proc~update_water_phases_thermal update_water_phases_thermal proc~update_water_phases~3 type_physics_manager%update_water_phases proc~update_water_phases_thermal->proc~update_water_phases~3 proc~update_water_phases type_models_manager%update_water_phases proc~update_water_phases~3->proc~update_water_phases proc~update_water_phases~2 type_phase_manager%update_water_phases proc~update_water_phases->proc~update_water_phases~2 calc_ice_content calc_ice_content proc~update_water_phases~2->calc_ice_content calc_ice_content_derivatives calc_ice_content_derivatives proc~update_water_phases~2->calc_ice_content_derivatives calc_water_content calc_water_content proc~update_water_phases~2->calc_water_content calc_water_content_derivatives calc_water_content_derivatives proc~update_water_phases~2->calc_water_content_derivatives proc~calc_vapor_content_derivatives type_evaporation%calc_vapor_content_derivatives proc~update_water_phases~2->proc~calc_vapor_content_derivatives proc~calc_vapor_content_vaporization type_evaporation%calc_vapor_content_vaporization proc~update_water_phases~2->proc~calc_vapor_content_vaporization proc~get_field_dp type_field_dp%get_field_dp proc~update_water_phases~2->proc~get_field_dp proc~set_field_dp type_field_dp%set_field_dp proc~upd