d0 * ( 1.0d0 + r % x ) case ( 4 ) dpsi_val = 0.25d0 * ( 1.0d0 - r % x ) end select end select end subroutine calc_dpsi_square_first","tags":"","url":"proc/calc_dpsi_square_first.html"},{"title":"calc_jacobian_square_first – FTDSS","text":"pure module subroutine calc_jacobian_square_first(self, r, node_coords, jac) Interface → Calculates the Jacobian matrix.\nStandard definition: J(i, j) = d(x_i) / d(xi_j) Arguments Type Intent Optional Attributes Name class( type_square_first ), intent(in) :: self type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(in) :: node_coords (:,:) real(kind=real64), intent(inout) :: jac (:,:) Calls proc~~calc_jacobian_square_first~~CallsGraph proc~calc_jacobian_square_first calc_jacobian_square_first interface~calc_dpsi_square_first type_square_first%calc_dpsi_square_first proc~calc_jacobian_square_first->interface~calc_dpsi_square_first proc~calc_dpsi_square_first calc_dpsi_square_first interface~calc_dpsi_square_first->proc~calc_dpsi_square_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~calc_jacobian_square_first~~CalledByGraph proc~calc_jacobian_square_first calc_jacobian_square_first interface~calc_jacobian_square_first type_square_first%calc_jacobian_square_first interface~calc_jacobian_square_first->proc~calc_jacobian_square_first proc~is_in_square_first is_in_square_first proc~is_in_square_first->interface~calc_jacobian_square_first interface~is_in_square_first type_square_first%is_in_square_first interface~is_in_square_first->proc~is_in_square_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure module subroutine calc_jacobian_square_first ( self , r , node_coords , jac ) implicit none class ( type_square_first ), intent ( in ) :: self type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( in ) :: node_coords (:, :) real ( real64 ), intent ( inout ) :: jac (:, :) integer ( int32 ) :: k real ( real64 ) :: dpsi_xi real ( real64 ) :: dpsi_eta real ( real64 ) :: xk real ( real64 ) :: yk jac = 0.0d0 do k = 1 , 4 xk = node_coords ( 1 , k ) yk = node_coords ( 2 , k ) call self % calc_dpsi ( k , 1 , r , dpsi_xi ) call self % calc_dpsi ( k , 2 , r , dpsi_eta ) ! Row 1: x derivatives jac ( 1 , 1 ) = jac ( 1 , 1 ) + dpsi_xi * xk ! dx/dxi jac ( 1 , 2 ) = jac ( 1 , 2 ) + dpsi_eta * xk ! dx/deta (was yk*dpsi_xi) ! Row 2: y derivatives jac ( 2 , 1 ) = jac ( 2 , 1 ) + dpsi_xi * yk ! dy/dxi (was xk*dpsi_eta) jac ( 2 , 2 ) = jac ( 2 , 2 ) + dpsi_eta * yk ! dy/deta end do end subroutine calc_jacobian_square_first","tags":"","url":"proc/calc_jacobian_square_first.html"},{"title":"calc_psi_square_first – FTDSS","text":"pure elemental module subroutine calc_psi_square_first(self, i, r, psi_val) Interface → Arguments Type Intent Optional Attributes Name class( type_square_first ), intent(in) :: self integer(kind=int32), intent(in) :: i type( type_coordinate_dp ), intent(in) :: r real(kind=real64), intent(inout) :: psi_val Called by proc~~calc_psi_square_first~~CalledByGraph proc~calc_psi_square_first calc_psi_square_first interface~calc_psi_square_first type_square_first%calc_psi_square_first interface~calc_psi_square_first->proc~calc_psi_square_first proc~is_in_square_first is_in_square_first proc~is_in_square_first->interface~calc_psi_square_first interface~is_in_square_first type_square_first%is_in_square_first interface~is_in_square_first->proc~is_in_square_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure elemental module subroutine calc_psi_square_first ( self , i , r , psi_val ) implicit none class ( type_square_first ), intent ( in ) :: self integer ( int32 ), intent ( in ) :: i type ( type_coordinate_dp ), intent ( in ) :: r real ( real64 ), intent ( inout ) :: psi_val select case ( i ) case ( 1 ) psi_val = 0.25d0 * ( 1.0d0 - r % x ) * ( 1.0d0 - r % y ) case ( 2 ) psi_val = 0.25d0 * ( 1.0d0 + r % x ) * ( 1.0d0 - r % y ) case ( 3 ) psi_val = 0.25d0 * ( 1.0d0 + r % x ) * ( 1.0d0 + r % y ) case ( 4 ) psi_val = 0.25d0 * ( 1.0d0 - r % x ) * ( 1.0d0 + r % y ) case default psi_val = 0.0d0 end select end subroutine calc_psi_square_first","tags":"","url":"proc/calc_psi_square_first.html"},{"title":"is_in_square_first – FTDSS","text":"module subroutine is_in_square_first(self, cartesian, normalized, node_coords, is_in) Interface → Arguments Type Intent Optional Attributes Name class( type_square_first ), intent(in) :: self type( type_coordinate_dp ), intent(in) :: cartesian type( type_coordinate_dp ), intent(inout) :: normalized real(kind=real64), intent(in) :: node_coords (:,:) logical, intent(inout) :: is_in Calls proc~~is_in_square_first~~CallsGraph proc~is_in_square_first is_in_square_first interface~calc_jacobian_determinant_abst_fe abst_fe%calc_jacobian_determinant_abst_fe proc~is_in_square_first->interface~calc_jacobian_determinant_abst_fe interface~calc_jacobian_square_first type_square_first%calc_jacobian_square_first proc~is_in_square_first->interface~calc_jacobian_square_first interface~calc_psi_square_first type_square_first%calc_psi_square_first proc~is_in_square_first->interface~calc_psi_square_first interface~get_num_nodes abst_fe%get_num_nodes proc~is_in_square_first->interface~get_num_nodes none~set~12 type_coordinate_dp%set proc~is_in_square_first->none~set~12 proc~calc_jacobian_determinant_abst_fe calc_jacobian_determinant_abst_fe interface~calc_jacobian_determinant_abst_fe->proc~calc_jacobian_determinant_abst_fe proc~calc_jacobian_square_first calc_jacobian_square_first interface~calc_jacobian_square_first->proc~calc_jacobian_square_first proc~calc_psi_square_first calc_psi_square_first interface~calc_psi_square_first->proc~calc_psi_square_first proc~get_num_nodes get_num_nodes interface~get_num_nodes->proc~get_num_nodes proc~set_coordinate_dp type_coordinate_dp%set_coordinate_dp none~set~12->proc~set_coordinate_dp proc~set_coordinate_dp_array type_coordinate_dp%set_coordinate_dp_array none~set~12->proc~set_coordinate_dp_array calc_jacobian calc_jacobian proc~calc_jacobian_determinant_abst_fe->calc_jacobian interface~matrix_determinant matrix_determinant proc~calc_jacobian_determinant_abst_fe->interface~matrix_determinant interface~calc_dpsi_square_first type_square_first%calc_dpsi_square_first proc~calc_jacobian_square_first->interface~calc_dpsi_square_first proc~calc_dpsi_square_first calc_dpsi_square_first interface~calc_dpsi_square_first->proc~calc_dpsi_square_first proc~matrix_determinant_real64 matrix_determinant_real64 interface~matrix_determinant->proc~matrix_determinant_real64 allocate_array allocate_array proc~matrix_determinant_real64->allocate_array deallocate_array deallocate_array proc~matrix_determinant_real64->deallocate_array Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~is_in_square_first~~CalledByGraph proc~is_in_square_first is_in_square_first interface~is_in_square_first type_square_first%is_in_square_first interface~is_in_square_first->proc~is_in_square_first Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine is_in_square_first ( self , cartesian , normalized , node_coords , is_in ) implicit none class ( type_square_first ), intent ( in ) :: self type ( type_coordinate_dp ), intent ( in ) :: cartesian type ( type_coordinate_dp ), intent ( inout ) :: normalized real ( real64 ), intent ( in ) :: node_coords (:, :) logical , intent ( inout ) :: is_in type ( type_coordinate_dp ) :: r type ( type_coordinate_dp ) :: interpolated_pos real ( real64 ) :: det_j real ( real64 ) :: dx real ( real64 ) :: dy real ( real64 ) :: jac ( 2 , 2 ) real ( real64 ) :: psi_val integer ( int32 ) :: iter integer ( int32 ) :: i integer ( int32 ) :: nn logical :: converged real ( real64 ), parameter :: tol = 1.0e-9 integer ( int32 ), parameter :: max_iter = 10 call r % set ( 0.0d0 , 0.0d0 , 0.0d0 ) call self % get_num_nodes ( nn ) converged = . false . do iter = 1 , max_iter call interpolated_pos % set ( 0.0d0 , 0.0d0 , 0.0d0 ) do i = 1 , nn call self % calc_psi ( i , r , psi_val ) interpolated_pos % x = interpolated_pos % x + psi_val * node_coords ( 1 , i ) interpolated_pos % y = interpolated_pos % y + psi_val * node_coords ( 2 , i ) end do dx = cartesian % x - interpolated_pos % x dy = cartesian % y - interpolated_pos % y if ( sqrt ( dx ** 2 + dy ** 2 ) < tol ) then converged = . true . exit end if call self % calc_jacobian_determinant ( r , node_coords , det_j ) if ( abs ( det_j ) < epsilon ( det_j )) exit call self % calc_jacobian ( r , node_coords , jac ) ! Inverse Jacobian Update: ! dxi = (J22*dx - J12*dy) / det ! deta = (-J21*dx + J11*dy) / det r % x = r % x + ( jac ( 2 , 2 ) * dx - jac ( 1 , 2 ) * dy ) / det_j r % y = r % y + ( - jac ( 2 , 1 ) * dx + jac ( 1 , 1 ) * dy ) / det_j end do is_in = converged . and . ( abs ( r % x ) <= 1.0d0 + tol ) . and . ( abs ( r % y ) <= 1.0d0 + tol ) if ( is_in ) normalized = r end subroutine is_in_square_first","tags":"","url":"proc/is_in_square_first.html"},{"title":"calculate_wrf_vg – FTDSS","text":"module subroutine calculate_wrf_vg(self, h, Qw) Arguments Type Intent Optional Attributes Name class(type_wrf_vg), intent(in) :: self real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: Qw Source Code module subroutine calculate_wrf_vg ( self , h , Qw ) implicit none class ( type_wrf_vg ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: Qw if ( h < 0.0d0 ) then Qw = self % params % theta_r + ( self % params % theta_s - self % params % theta_r ) & * ( 1.0d0 + ( - self % params % alpha1 * h ) ** self % params % n1 ) ** ( - self % params % m1 ) else Qw = self % params % theta_s end if end subroutine calculate_wrf_vg","tags":"","url":"proc/calculate_wrf_vg.html"},{"title":"calculate_wrf_vg_derivative – FTDSS","text":"module subroutine calculate_wrf_vg_derivative(self, h, dQw_dh) Arguments Type Intent Optional Attributes Name class(type_wrf_vg), intent(in) :: self real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: dQw_dh Source Code module subroutine calculate_wrf_vg_derivative ( self , h , dQw_dh ) implicit none class ( type_wrf_vg ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: dQw_dh if ( h < 0.0d0 ) then dQw_dh = ( self % params % theta_s - self % params % theta_r ) * & self % params % alpha1 ** self % params % n1 * self % params % m1 * self % params % n1 * ( - h ) ** ( self % params % n1 - 1.0d0 ) & * ( 1.0d0 + ( - self % params % alpha1 * h ) ** self % params % n1 ) ** ( - self % params % m1 - 1.0d0 ) else dQw_dh = 0.0d0 end if end subroutine calculate_wrf_vg_derivative","tags":"","url":"proc/calculate_wrf_vg_derivative.html"},{"title":"execute_condition_boundary – FTDSS","text":"module subroutine execute_condition_boundary(self, input, index, target_physics, config_bc) Inte