t ( inout ) :: kr real ( real64 ) :: Sw if ( h < 0.0d0 ) then Sw = ( 1.0d0 + ( - alpha1 * h ) ** n1 ) ** ( - m1 ) else Sw = 1.0d0 end if kr = Sw ** l * ( 1.0d0 - ( 1.0d0 - Sw ** ( 1.0d0 / m1 )) ** m1 ) ** 2 end subroutine calc_kr_vg !---------------------------------------------------------------------------------------------------- ! Wrapper of calculating kr for van-Genuchten model bounding different derived types !---------------------------------------------------------------------------------------------------- module subroutine calc_kr_base_vg ( self , h , kr ) implicit none class ( type_hcf_base_vg ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: kr associate ( params => self % parent % params ) call calc_kr_vg ( params % alpha1 , params % n1 , params % m1 , params % l , h , kr ) end associate end subroutine calc_kr_base_vg end submodule hcf_vg","tags":"","url":"sourcefile/hcf_vg.f90.html"},{"title":"control.F90 – FTDSS","text":"This file depends on sourcefile~~control.f90~~EfferentGraph sourcefile~control.f90 control.F90 sourcefile~core.f90 core.F90 sourcefile~control.f90->sourcefile~core.f90 sourcefile~input.f90 input.F90 sourcefile~control.f90->sourcefile~input.f90 sourcefile~iteration.f90 iteration.F90 sourcefile~control.f90->sourcefile~iteration.f90 sourcefile~linalg.f90 linalg.F90 sourcefile~control.f90->sourcefile~linalg.f90 sourcefile~openmp.f90 openmp.F90 sourcefile~control.f90->sourcefile~openmp.f90 sourcefile~output.f90 output.F90 sourcefile~control.f90->sourcefile~output.f90 sourcefile~time.f90 time.F90 sourcefile~control.f90->sourcefile~time.f90 sourcefile~time_profiler.f90 time_profiler.F90 sourcefile~control.f90->sourcefile~time_profiler.f90 sourcefile~constants.f90 constants.F90 sourcefile~core.f90->sourcefile~constants.f90 sourcefile~interop.f90 interop.F90 sourcefile~core.f90->sourcefile~interop.f90 sourcefile~memory.f90 memory.F90 sourcefile~core.f90->sourcefile~memory.f90 sourcefile~types.f9