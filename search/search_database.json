END ) call date_and_time ( date = self % record_end % date , time = self % record_end % time , & zone = self % record_end % zone ) self % record_end % label = get_time_record_string ( label ) end select end subroutine record_profiler","tags":"","url":"proc/record_profiler.html"},{"title":"start_profile_by_id – FTDSS","text":"private  subroutine start_profile_by_id(self, id) Type Bound type_profiler Arguments Type Intent Optional Attributes Name class( type_profiler ), intent(inout) :: self integer(kind=int32), intent(in) :: id Calls proc~~start_profile_by_id~~CallsGraph proc~start_profile_by_id type_profiler%start_profile_by_id proc~get_current_wall_time type_profiler%get_current_wall_time proc~start_profile_by_id->proc~get_current_wall_time Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~start_profile_by_id~~CalledByGraph proc~start_profile_by_id type_profiler%start_profile_by_id none~start~3 type_profiler%start none~start~3->proc~start_profile_by_id proc~start_profile_by_name type_profiler%start_profile_by_name none~start~3->proc~start_profile_by_name proc~start_profile_by_name->proc~start_profile_by_id proc~assemble_ftdss assemble_ftdss proc~assemble_ftdss->none~start~3 proc~initialize_type_ftdss initialize_type_ftdss proc~initialize_type_ftdss->none~start~3 interface~output_fields_ftdss type_ftdss%output_fields_ftdss proc~