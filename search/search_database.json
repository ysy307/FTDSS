( scope ) . or . present ( line )) then full_msg = trim ( full_msg ) // \" [\" if ( present ( scope )) then full_msg = trim ( full_msg ) // strip ( scope ) if ( present ( line )) then full_msg = trim ( full_msg ) // \":\" end if end if if ( present ( line )) then if (. not . present ( scope )) then full_msg = trim ( full_msg ) // \"Line:\" end if line_str = to_string ( line ) full_msg = trim ( full_msg ) // trim ( line_str ) end if full_msg = trim ( full_msg ) // \"]\" end if ! 4. STOP Execution error stop trim ( full_msg ) end subroutine raise_error ! -------------------------------------------------------------------------- ! Internal Helpers ! -------------------------------------------------------------------------- !> Simple Pure placeholder replacer for '{}' !> Returns an allocated string of the exact required length. pure function replace_placeholder ( tmpl , val ) result ( res ) character ( * ), intent ( in ) :: tmpl , val character (:), allocatable :: res integer ( int32 ) :: idx character ( * ), parameter :: PH = '{}' idx = index ( tmpl , PH ) if ( idx > 0 ) then ! Replace first occurrence of {} ! Critical: trim(tmpl(idx+2:)) prevents including huge trailing spaces from fixed-length strings res = tmpl ( 1 : idx - 1 ) // strip ( val ) // trim ( tmpl ( idx + 2 :)) else res = trim ( tmpl ) end if end function replace_placeholder end module core_error","tags":"","url":"sourcefile/error.f90.html"},{"title":"output_standard.F90 – FTDSS","text":"This file depends on sourcefile~~output_standard.f90~~EfferentGraph sourcefile~output_standard.f90 output_standard.F90 sourcefile~output_interface.f90~2 output_interface.F90 sourcefile~output_standard.f90->sourcefile~output_interface.f90~2 sourcefile~core.f90 core.F90 sourcefile~output_interface.f90~2->sourcefile~core.f90 sourcefile~input_base.f90 input_base.F90 sourcefile~output_interface.f90~2->sourcefile~input_base.f90 sourcefile~constants.f90 constants.F90 sourcefile~core.f90->sourcefile~constants.f90 sourcefile~inter