 , num_nodes ) end subroutine assemble_initialize_ftdss","tags":"","url":"proc/assemble_initialize_ftdss.html"},{"title":"assemble_local_ftdss – FTDSS","text":"module subroutine assemble_local_ftdss(self, workspace, local_K_TT, local_K_TH, local_K_HH, local_K_HT, local_F_T, local_F_H) Interface → Arguments Type Intent Optional Attributes Name class( type_ftdss ), intent(inout) :: self type( type_assemble_workspace ), intent(inout) :: workspace type( type_matrix_dense ), intent(inout), optional :: local_K_TT type( type_matrix_dense ), intent(inout), optional :: local_K_TH type( type_matrix_dense ), intent(inout), optional :: local_K_HH type( type_matrix_dense ), intent(inout), optional :: local_K_HT type( type_vector_dp ), intent(inout), optional :: local_F_T type( type_vector_dp ), intent(inout), optional :: local_F_H Calls proc~~assemble_local_ftdss~~CallsGraph proc~assemble_local_ftdss assemble_local_ftdss interface~assemble_local_thermal type_thermal%assemble_local_thermal proc~assemble_local_ftdss->interface~assemble_local_thermal proc~assemble_local_thermal assemble_local_thermal interface~assemble_local_thermal->proc~assemble_local_thermal interface~assemble_local_newton_thermal type_thermal%assemble_local_newton_thermal proc~assemble_local_thermal->interface~assemble_local_newton_thermal interface~assemble_local_picard_thermal type_thermal%assemble_local_picard_thermal proc~assemble_local_thermal->interface~assemble_local_picard_thermal proc~is_compute_newton_method_iteration type_iteration%is_compute_newton_method_iteration proc~assemble_local_thermal->proc~is_compute_newton_method_iteration proc~is_compute_picard_method_iteration type_iteration%is_compute_picard_method_iteration proc~assemble_local_thermal->proc~is_compute_picard_method_iteration proc~assemble_local_newton_thermal assemble_local_newton_thermal interface~assemble_local_newton_thermal->proc~assemble_local_newton_thermal proc~assemble_local_picard_thermal assemble_local_picard_thermal interfac