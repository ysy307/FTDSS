e_obsvalues.html"},{"title":"Output_Process_Observation – FTDSS","text":"module subroutine Output_Process_Observation(self, time, Temp, Si, TC, C, Pres, wFlux, K, Thermal, phi) Interface → Ice content Arguments Type Intent Optional Attributes Name class( Type_Output ) :: self real(kind=real64), intent(in) :: time real(kind=real64), intent(in), optional :: Temp (:) real(kind=real64), intent(in), optional :: Si (:) real(kind=real64), intent(in), optional :: TC (:) real(kind=real64), intent(in), optional :: C (:) real(kind=real64), intent(in), optional :: Pres (:) real(kind=real64), intent(in), optional :: wFlux (:) real(kind=real64), intent(in), optional :: K (:) class( Abstract_Thermal ), intent(inout), optional :: Thermal real(kind=real64), intent(in), optional :: phi (:) Calls proc~~output_process_observation~~CallsGraph proc~output_process_observation Output_Process_Observation calculate_ice calculate_ice proc~output_process_observation->calculate_ice interface~initialize_observation_header Type_Output%Initialize_Observation_Header proc~output_process_observation->interface~initialize_observation_header interface~interpolate_obsvalues Type_Output%Interpolate_ObsValues proc~output_process_observation->interface~interpolate_obsvalues proc~output_observation_line Output_Observation_Line proc~output_process_observation->proc~output_observation_line proc~initialize_observation_header Initialize_Observation_Header interface~initialize_observation_header->proc~initialize_observation_header proc~interpolate_obsvalues Interpolate_ObsValues interface~interpolate_obsvalues->proc~interpolate_obsvalues to_string to_string proc~output_observation_line->to_string interface~write_observation_header Type_Output%Write_Observation_Header proc~initialize_observation_header->interface~write_observation_header getNumNodes getNumNodes proc~interpolate_obsvalues->getNumNodes psi psi proc~interpolate_obsvalues->psi proc~write_observation_header Write_Observation_Header interface~write_obs