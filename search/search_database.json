ha(j) !------------------------------------------------- case ( OP_SCALE_SYMM_DIAG ) !$omp parallel do default(shared) private(i, j, col_idx) schedule(static) do j = 1 , self % num_diags do i = 1 , self % num_rows col_idx = i + self % offsets ( j ) ! Check bounds for valid columns if ( col_idx >= 1 . and . col_idx <= self % num_cols ) then self % val ( i , j ) = self % val ( i , j ) * alpha_data ( i ) * alpha_data ( col_idx ) end if end do end do !$omp end parallel do self % status = MATRIX_STATUS_SUCCESS !------------------------------------------------- ! Jacobi Scaling: A_ij <- A_ij * alpha(i) !------------------------------------------------- case ( OP_SCALE_JACOBI ) !$omp parallel do default(shared) private(i, j) schedule(static) do j = 1 , self % num_diags do i = 1 , self % num_rows self % val ( i , j ) = self % val ( i , j ) * alpha_data ( i ) end do end do !$omp end parallel do self % status = MATRIX_STATUS_SUCCESS case default self % status = MATRIX_STATUS_ILL_OPERATIONS end select end subroutine scale_dia","tags":"","url":"proc/scale_dia.html"},{"title":"set_all_dia – FTDSS","text":"module subroutine set_all_dia(self, op, value) Interface → Arguments Type Intent Optional Attributes Name class( type_matrix_dia ), intent(inout) :: self integer(kind=int32), intent(in) :: op real(kind=real64), intent(in) :: value Called by proc~~set_all_dia~~CalledByGraph proc~set_all_dia set_all_dia interface~set_all_dia type_matrix_dia%set_all_dia interface~set_all_dia->proc~set_all_dia none~set~16 type_matrix_dense%set none~set~16->interface~set_all_dia none~set~9 abst_matrix%set none~set~9->interface~set_all_dia proc~add_local_jacobian_matrix type_jacobian_matrix%add_local_jacobian_matrix proc~add_local_jacobian_matrix->none~set~9 proc~add_value_jacobian_matrix type_jacobian_matrix%add_value_jacobian_matrix proc~add_value_jacobian_matrix->none~set~9 proc~assemble_local_newton_hydraulic assemble_local_newton_hydraulic proc~assemble_local_newton_hydraulic->none~set~16 proc~a