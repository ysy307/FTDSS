r(p2) !         pe = A%Ptr(p2 + 1) - 1 !         A%val(ps:pe) = 0.0d0 !         A%val(ind) = 1.0d0 !     end if !     b(p1) = Dval !     b(p2) = Dval ! end if end subroutine apply_CRS_Adiabatic_base","tags":"","url":"proc/apply_crs_adiabatic_base.html"},{"title":"apply_Dense_Adiabatic_base – FTDSS","text":"subroutine apply_Dense_Adiabatic_base(A, b, isUniform, Edge, Dval, perm) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), optional :: A (:,:) real(kind=real64), intent(inout) :: b (:) logical(kind=logical32), intent(in) :: isUniform integer(kind=int32), intent(in) :: Edge (2) real(kind=real64), intent(in) :: Dval integer(kind=int32), intent(in) :: perm (:) Source Code subroutine apply_Dense_Adiabatic_base ( A , b , isUniform , Edge , Dval , perm ) implicit none real ( real64 ), intent ( inout ), optional :: A (:, :) real ( real64 ), intent ( inout ) :: b (:) logical ( logical32 ), intent ( in ) :: isUniform integer ( int32 ), intent ( in ) :: Edge ( 2 ) real ( real64 ), intent ( in ) :: Dval integer ( int32 ), intent ( in ) :: perm (:) integer ( int32 ) :: i , ind , ps , pe integer ( int32 ) :: p1 , p2 ! if (isUniform) then !     p1 = perm(Edge(1)) !     p2 = perm(Edge(2)) !     if (present(A)) then !         A(p1, :) = 0.0d0 !         A(p1, p1) = 1.0d0 !         A(p2, :) = 0.0d0 !         A(p2, p2) = 1.0d0 !     end if !     b(p1) = Dval !     b(p2) = Dval ! end if end subroutine apply_Dense_Adiabatic_base","tags":"","url":"proc/apply_dense_adiabatic_base.html"},{"title":"apply_Dense_Dirichlet_base – FTDSS","text":"subroutine apply_Dense_Dirichlet_base(A, b, is_uniform, edge, value_dirichlet) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), optional :: A (:,:) real(kind=real64), intent(inout) :: b (:) logical, intent(in) :: is_uniform integer(kind=int32), intent(in) :: edge (2) real(kind=real64), intent(in) :: value_dirichlet Source Code subroutine apply_Dense_Dirichlet_base ( A , b , is_uniform , ed