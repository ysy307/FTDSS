NG) type ( type_constant_error ), intent ( in ) :: err !> String to replace '{}' in the message template character ( * ), optional , intent ( in ) :: opt !> Scope name (e.g. 'module_name:procedure_name') character ( * ), optional , intent ( in ) :: scope !> Line number where the error occurred (usually __LINE__) integer ( int32 ), optional , intent ( in ) :: line character (:), allocatable :: msg_body character ( 2048 ) :: full_msg character ( 20 ) :: line_str ! 1. Base Message Construction if ( present ( opt )) then ! replace_placeholder now handles trimming correctly msg_body = replace_placeholder ( err % message , opt ) else msg_body = trim ( err % message ) end if ! 2. Start constructing the full message ! Format: \"# 901(INPUT_DIR_MISSING): Message body\" full_msg = \"# \" // trim ( to_string ( err % id )) // & \"(\" // trim ( strip ( err % name )) // \"): \" // msg_body ! 3. Add Scope and Line info ! Format: \" [scope:line]\" or \" [scope]\" or \" [Line:line]\" if ( present ( scope ) . or . present ( line )) then full_msg = trim ( full_msg ) // \" [\" if ( present ( scope )) then full_msg = trim ( full_msg ) // strip ( scope ) if ( present ( line )) then full_msg = trim ( full_msg ) // \":\" end if end if if ( present ( line )) then if (. not . present ( scope )) then full_msg = trim ( full_msg ) // \"Line:\" end if line_str = to_string ( line ) full_msg = trim ( full_msg ) // trim ( line_str ) end if full_msg = trim ( full_msg ) // \"]\" end if ! 4. STOP Execution error stop trim ( full_msg ) end subroutine raise_error","tags":"","url":"proc/raise_error.html"},{"title":"format_iso_datetime – FTDSS","text":"private  function format_iso_datetime(self) result(formatted_strings) Outputs the state as a full ISO 8601 string.\nDetermine the sign for the timezone offset Type Bound type_datetime Arguments Type Intent Optional Attributes Name class( type_datetime ), intent(in) :: self The type_datetime instance Return Value character(len=25) The formatted string (length 25) Source Code function format_iso_datetime ( self ) result ( formatted_strings ) implicit none !> The type_datetime instance class ( type_datetime ), intent ( in ) :: self !> The formatted string (length 25) character ( len = 25 ) :: formatted_strings character ( len = 1 ) :: sign integer ( int32 ) :: abs_tz , tz_h , tz_m !> Determine the sign for the timezone offset if ( self % timezone_offset >= 0 ) then sign = '+' else sign = '-' end if ! Calculate timezone hours and minutes abs_tz = abs ( self % timezone_offset ) tz_h = abs_tz / 60 tz_m = mod ( abs_tz , 60 ) write ( formatted_strings , '(i4.4, \"-\", i2.2, \"-\", i2.2, \"T\", i2.2, \":\", i2.2, \":\", i2.2, A, i2.2, \":\", i2.2)' ) & self % year , self % month , self % day , self % hour , self % minute , self % second , sign , tz_h , tz_m end function format_iso_datetime","tags":"","url":"proc/format_iso_datetime.html"},{"title":"is_iso_string_datetime – FTDSS","text":"private pure function is_iso_string_datetime(self, iso_str) result(is_iso) Validates ISO 8601 format (pure function for safety). Type Bound type_datetime Arguments Type Intent Optional Attributes Name class( type_datetime ), intent(in) :: self The type_datetime instance character(len=*), intent(in) :: iso_str ISO 8601 formatted string Return Value logical Result flag Called by proc~~is_iso_string_datetime~~CalledByGraph proc~is_iso_string_datetime type_datetime%is_iso_string_datetime proc~set_from_iso_string type_datetime%set_from_iso_string proc~set_from_iso_string->proc~is_iso_string_datetime none~set~10 type_datetime%set none~set~10->proc~set_from_iso_string proc~initialize_meteorology_data type_meteorology_data%initialize_meteorology_data proc~initialize_meteorology_data->none~set~10 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function is_iso_string_datetime ( self , iso_str ) result ( is_iso ) implicit none !> The type_datetime instance class ( type_datetime ), intent ( in ) :: self !> ISO 8601 formatted string character ( len =* ), intent ( in ) :: iso_str !> Result flag logical :: is_iso integer ( int32 ) :: length , ios , y , m , d , h , n , s character ( len = 1 ) :: sep_t , sep_z is_iso = . false . length = len_trim ( iso_str ) if ( length < 10 ) return ! YYYY-MM-DD if ( iso_str ( 5 : 5 ) /= '-' . or . iso_str ( 8 : 8 ) /= '-' ) return read ( iso_str ( 1 : 4 ), '(i4)' , iostat = ios ) y if ( ios /= 0 ) return read ( iso_str ( 6 : 7 ), '(i2)' , iostat = ios ) m if ( ios /= 0 . or . m < 1 . or . m > 12 ) return read ( iso_str ( 9 : 10 ), '(i2)' , iostat = ios ) d if ( ios /= 0 . or . d < 1 . or . d > 31 ) return if ( length == 10 ) then is_iso = . true . return end if ! Time Part (T) sep_t = iso_str ( 11 : 11 ) if ( sep_t /= 'T' . and . sep_t /= ' ' ) return ! hh:mm if ( length >= 16 ) then if ( iso_str ( 14 : 14 ) /= ':' ) return read ( iso_str ( 12 : 13 ), '(i2)' , iostat = ios ) h if ( ios /= 0 . or . h < 0 . or . h > 23 ) return read ( iso_str ( 15 : 16 ), '(i2)' , iostat = ios ) n if ( ios /= 0 . or . n < 0 . or . n > 59 ) return end if ! ss if ( length >= 19 ) then if ( iso_str ( 17 : 17 ) /= ':' ) return read ( iso_str ( 18 : 19 ), '(i2)' , iostat = ios ) s if ( ios /= 0 . or . s < 0 . or . s > 59 ) return end if ! Timezone Suffix if ( length > 19 ) then sep_z = iso_str ( 20 : 20 ) if ( sep_z /= 'Z' . and . sep_z /= '+' . and . sep_z /= '-' ) return end if is_iso = . true . end function is_iso_string_datetime","tags":"","url":"proc/is_iso_string_datetime.html"},{"title":"get_datetime_components – FTDSS","text":"private  subroutine get_datetime_components(self, y, m, d, h, min, sec, tz) Returns components via arguments. Type Bound type_datetime Arguments Type Intent Optional Attributes Name class( type_datetime ), intent(in) :: self The type_datetime instance integer(kind=int32), intent(inout) :: y Year component integer(kind=int32), intent(inout) :: m Month component integer(kind=int32), intent(inout) :: d Day component integer(kind=int32), intent(inout) :: h Hour component integer(kind=int32), intent(inout) :: min Minute component integer(kind=int32), intent(inout) :: sec Second component integer(kind=int32), intent(inout) :: tz Timezone offset component Called by proc~~get_datetime_components~~CalledByGraph proc~get_datetime_components type_datetime%get_datetime_components proc~get_events_from_dt type_solar_system%get_events_from_dt proc~get_events_from_dt->proc~get_datetime_components none~get_day_events type_solar_system%get_day_events proc~get_events_from_dt->none~get_day_events proc~get_pos_from_dt type_solar_system%get_pos_from_dt proc~get_pos_from_dt->proc~get_datetime_components none~get_day_events->proc~get_events_from_dt Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_datetime_components ( self , y , m , d , h , min , sec , tz ) implicit none !> The type_datetime instance class ( type_datetime ), intent ( in ) :: self !> Year component integer ( int32 ), intent ( inout ) :: y !> Month component integer ( int32 ), intent ( inout ) :: m !> Day component integer ( int32 ), intent ( inout ) :: d !> Hour component integer ( int32 ), intent ( inout ) :: h !> Minute component integer ( int32 ), intent ( inout ) :: min !> Second component integer ( int32 ), intent ( inout ) :: sec !> Timezone offset component integer ( int32 ), intent ( inout ) :: tz y = self % year m = self % month d = self % day h = self % hour min = self % minute sec = self % second tz = self % timezone_offset end subroutine get_datetime_components","tags":"","url":"proc/get_datetime_components.html"},{"title":"set_datetime – FTDSS","text":"private  subroutine set_datetime(self, year, month, day, hour, minute, second, millisecond, timezone_offset) Manually sets the date and time components. Type Bound type_datetime Arguments Type Intent Optional Attributes Name class( type_datetime ), intent(inout) :: self The type_datetime instance integer(kind=int32), intent(in) :: year Year integer(kind=int32), intent(in) :: month Month integer(kind=int32), intent(in) :: day Day integer(kind=int32), intent(in), optional :: hour Hour integer(kind=int32), intent(in), optional :: minute Minute integer(kind=int32), intent(in), optional :: second Second integer(kind=int32), intent(in), optional :: millisecond Millisecond integer(kind=int32), intent(in), optional :: timezone_offset Timezone offset in minutes Calls proc~~set_datetime~~CallsGraph proc~set_datetime type_datetime%set_datetime optval optval proc~set_datetime->optval Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program