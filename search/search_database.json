urrent ( u ) nullify ( u ) end if if ( self % controls % is_physics_active ( PHYSICS_TYPES % THERMAL )) then call self % temperature % get_previous ( u ) if ( associated ( u )) then call self % temperature % set_current ( u ) nullify ( u ) end if end if if ( self % controls % is_physics_active ( PHYSICS_TYPES % HYDRAULIC )) then call self % pressure % get_previous ( u ) if ( associated ( u )) then call self % pressure % set_current ( u ) nullify ( u ) end if end if end subroutine solve_time_step_initial_setup_ftdss","tags":"","url":"proc/solve_time_step_initial_setup_ftdss.html"},{"title":"solve_time_step_setup_ftdss – FTDSS","text":"module subroutine solve_time_step_setup_ftdss(self, prescribe_bc) Interface → Arguments Type Intent Optional Attributes Name class( type_ftdss ), intent(inout) :: self logical, intent(inout) :: prescribe_bc Calls proc~~solve_time_step_setup_ftdss~~CallsGraph proc~solve_time_step_setup_ftdss solve_time_step_setup_ftdss interface~calc_gradient_pressure_ftdss type_ftdss%calc_gradient_pressure_ftdss proc~solve_time_step_setup_ftdss->interface~calc_gradient_pressure_ftdss interface~calc_gradient_temperature_ftdss type_ftdss%calc_gradient_temperature_ftdss proc~solve_time_step_setup_ftdss->interface~calc_gradient_temperature_ftdss proc~get_nonlinear_iter type_iteration%get_nonlinear_iter proc~solve_time_step_setup_ftdss->proc~get_nonlinear_iter proc~increment_nonlinear type_iteration%increment_nonlinear proc~solve_time_step_setup_ftdss->proc~increment_nonlinear proc~calc_gradient_pressure_ftdss calc_gradient_pressure_ftdss interface~calc_gradient_pressure_ftdss->proc~calc_gradient_pressure_ftdss proc~calc_gradient_temperature_ftdss calc_gradient_temperature_ftdss interface~calc_gradient_temperature_ftdss->proc~calc_gradient_temperature_ftdss get_current get_current proc~calc_gradient_pressure_ftdss->get_current get_current_gradient get_current_gradient proc~calc_gradient_pressure_ftdss->get_current_gradient interface~calc_gradient_ftdss type_