 within block integer ( int32 ), intent ( in ) :: col_block ! Local col index within block real ( real64 ), intent ( in ) :: value integer ( int32 ) :: index #ifdef USE_DEBUG if (. not . value_in_range ( row_block , 1 , self % num_block_rows ) . or . & . not . value_in_range ( col_block , 1 , self % num_block_cols )) then self % status = MATRIX_STATUS_OUT_OF_MEMORY return end if #endif index = self % find ( row , col ) #ifdef USE_DEBUG if ( index < 0 ) then self % status = MATRIX_STATUS_OUT_OF_MEMORY return end if #endif select case ( op ) case ( OP_INS ) ! Access val(row_in_block, col_in_block, block_index) self % val ( row_block , col_block , index ) = value case ( OP_ADD ) self % val ( row_block , col_block , index ) = self % val ( row_block , col_block , index ) + value case default self % status = MATRIX_STATUS_ILL_OPERATIONS end select end subroutine set_value_block_bsr","tags":"","url":"proc/set_value_block_bsr.html"},{"title":"set_value_bsr – FTDSS","text":"module subroutine set_value_bsr(self, op, row, col, value) Interface → Sets the value of a specific entry (Not fully implemented for BSR yet, use block version). Arguments Type Intent Optional Attributes Name class( type_matrix_bsr ), intent(inout) :: self integer(kind=int32), intent(in) :: op integer(kind=int32), intent(in) :: row integer(kind=int32), intent(in) :: col real(kind=real64), intent(in) :: value Called by proc~~set_value_bsr~~CalledByGraph proc~set_value_bsr set_value_bsr interface~set_value_bsr type_matrix_bsr%set_value_bsr interface~set_value_bsr->proc~set_value_bsr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine set_value_bsr ( self , op , row , col , value ) implicit none class ( type_matrix_bsr ), intent ( inout ) :: self integer ( int32 ), intent ( in ) :: op integer ( int32 ), intent ( in ) :: row integer ( int32 ), intent ( in ) :: col real ( real64 ), intent ( in ) :: value self % status = MATRIX_STATUS_NOT_IMPLEMENTED end subroutine set_value_bsr","tags":"","url":"proc/set_value_bsr.html"},{"title":"zero_all_bsr – FTDSS","text":"module subroutine zero_all_bsr(self) Interface → Zero out the matrix. Arguments Type Intent Optional Attributes Name class( type_matrix_bsr ), intent(inout) :: self Called by proc~~zero_all_bsr~~CalledByGraph proc~zero_all_bsr zero_all_bsr interface~zero_all_bsr type_matrix_bsr%zero_all_bsr interface~zero_all_bsr->proc~zero_all_bsr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine zero_all_bsr ( self ) implicit none class ( type_matrix_bsr ), intent ( inout ) :: self self % val (:, :, :) = 0.0d0 self % status = MATRIX_STATUS_SUCCESS end subroutine zero_all_bsr","tags":"","url":"proc/zero_all_bsr.html"},{"title":"zero_row_bsr – FTDSS","text":"module subroutine zero_row_bsr(self, row, row_block) Interface → Sets all values in a specified row of the bsr matrix to zero. Arguments Type Intent Optional Attributes Name class( type_matrix_bsr ), intent(inout) :: self integer(kind=int32), intent(in) :: row integer(kind=int32), intent(in), optional :: row_block Calls proc~~zero_row_bsr~~CallsGraph proc~zero_row_bsr zero_row_bsr value_in_range value_in_range proc~zero_row_bsr->value_in_range Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~zero_row_bsr~~CalledByGraph proc~zero_row_bsr zero_row_bsr interface~zero_row_bsr type_matrix_bsr%zero_row_bsr interface~zero_row_bsr->proc~zero_row_bsr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module subroutine zero_row_bsr ( self , row , row_block ) implicit none class ( type_matrix_bsr ), intent ( inout ) :: self integer ( int32 ), intent ( in ) :: row integer ( int32 ), intent ( in ), optional :: row_block integer ( int32 ) :: is , ie , k , r_start , r_end , r ! 範囲チェック if (. not . value_in_range ( row , 1 , self % num_rows )) then self % status = MATRIX_STATUS_OUT_OF_MEMORY return end if is = self % ptr ( row ) ie = self % ptr ( row + 1 ) - 1 if ( present ( row_block )) then if ( row_block < 1 . or . row_block > self % num_block_rows ) then self % status = MATRIX_STATUS_OUT_OF_MEMORY return end if r_start = row_block r_end = row_block else r_start = 1 r_end = self % num_block_rows end if do k = is , ie ! Access val(row_in_block, col_in_block, block_index) do r = r_start , r_end self % val ( r , :, k ) = 0.0d0 end do end do self % status = MATRIX_STATUS_SUCCESS end subroutine zero_row_bsr","tags":"","url":"proc/zero_row_bsr.html"},{"title":"display_parameters_solver_settings – FTDSS","text":"module subroutine display_parameters_solver_settings(self) Interface → Display all solver settings. This is the main entry point. Arguments Type Intent Optional Attributes Name class( type_solver_settings ), intent(in) :: self Calls proc~~display_parameters_solver_settings~~CallsGraph proc~display_parameters_solver_settings display_parameters_solver_settings proc~display_solver_settings_linear display_solver_settings_linear proc~display_parameters_solver_settings->proc~display_solver_settings_linear proc~display_solver_settings_nonlinear display_solver_settings_nonlinear proc~display_parameters_solver_settings->proc~display_solver_settings_nonlinear proc~display_solver_settings_parallel display_solver_settings_parallel proc~display_parameters_solver_settings->proc~display_solver_settings_parallel proc~display_solver_convergence_criteria display_solver_convergence_criteria proc~display_solver_settings_nonlinear->proc~display_solver_convergenc