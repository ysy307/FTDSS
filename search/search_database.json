d < lbound ( fe_constructor , 1 ) . or . id > ubound ( fe_constructor , 1 )) then call global_logger % log_error ( func_name // \": ID is out of range. ID = \" // to_string ( id )) return end if ! --- Check constructor registration --- if (. not . associated ( fe_constructor ( id )% create )) then call global_logger % log_error ( func_name // \": No constructor registered for ID = \" // to_string ( id )) return end if ! --- Construct the object --- fe = fe_constructor ( id )% create ( integration_order ) end function create_fe","tags":"","url":"proc/create_fe.html"},{"title":"initialize_factory_internal – FTDSS","text":"private  subroutine initialize_factory_internal() Initializes the internal constructor table (factory).\nThis routine allocates the table and registers all available finite element\nconstructor procedures. Arguments None Calls proc~~initialize_factory_internal~~CallsGraph proc~initialize_factory_internal initialize_factory_internal proc~get_cell_type type_vtk_constants%get_cell_type proc~initialize_factory_internal->proc~get_cell_type proc~get_max_cell_id type_vtk_constants%get_max_cell_id proc~initialize_factory_internal->proc~get_max_cell_id proc~register_constructor register_constructor proc~initialize_factory_internal->proc~register_constructor strip strip proc~get_cell_type->strip proc~initialize_vtk_constants type_vtk_constants%initialize_vtk_constants proc~get_max_cell_id->proc~initialize_vtk_constants log_warning log_warning proc~register_constructor->log_warning to_string to_string proc~register_constructor->to_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~initialize_factory_internal~~CalledByGraph proc~initialize_factory_internal initialize_factory_internal proc~create_fe create_fe proc~create_fe->proc~initialize_factory_internal proc~initialize_fe_manager type_fe_manager%initialize_fe_manager proc~initialize_fe_manager->proc~create_fe proc~create_bc_instances type_boundary_manager%create_bc_instances proc~create_bc_instances->proc~initialize_fe_manager proc~initialize_element_manager type_element_manager%initialize_element_manager proc~initialize_element_manager->proc~initialize_fe_manager proc~process_single_physics_bcs type_boundary_manager%process_single_physics_bcs proc~process_single_physics_bcs->proc~create_bc_instances proc~initialize_boundary_manager type_boundary_manager%initialize_boundary_manager proc~initialize_boundary_manager->proc~process_single_physics_bcs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine initialize_factory_internal () implicit none integer ( int32 ) :: max_fe_types max_fe_types = vtk_constants % get_max_cell_id () allocate ( fe_constructor ( 0 : max_fe_types )) ! Register available FE constructors call register_constructor ( vtk_constants % get_cell_type ( \"Line\" ), construct_side_first ) !& call register_constructor ( vtk_constants % get_cell_type ( \"QuadraticEdge\" ), construct_side_second ) !& call register_constructor ( vtk_constants % get_cell_type ( \"Triangle\" ), construct_triangle_first ) !& call register_constructor ( vtk_constants % get_cell_type ( \"Quad\" ), construct_square_first ) !& call register_constructor ( vtk_constants % get_cell_type ( \"QuadraticTriangle\" ), construct_triangle_second ) !& call register_constructor ( vtk_constants % get_cell_type ( \"QuadraticQuad\" ), construct_square_second ) !& end subroutine initialize_factory_internal","tags":"","url":"proc/initialize_factory_internal.html"},{"title":"register_constructor – FTDSS","text":"private  subroutine register_constructor(id, constructor) Registers a constructor procedure for a given VTK cell type ID.\nIf a constructor is already registered for the specified ID, it will be\noverwritten and a warning will be logged. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: id The VTK cell type ID to associate with the constructor. procedure( abst_fe_constructor ), intent(in), pointer :: constructor A procedure pointer to the constructor function. Calls proc~~register_constructor~~CallsGraph proc~register_constructor register_constructor log_warning log_warning proc~register_constructor->log_warning to_string to_string proc~register_constructor->to_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~register_constructor~~CalledByGraph proc~register_constructor register_constructor proc~initialize_factory_internal initialize_factory_internal proc~initialize_factory_internal->proc~register_constructor proc~create_fe create_fe proc~create_fe->proc~initialize_factory_internal proc~initialize_fe_manager type_fe_manager%initialize_fe_manager proc~initialize_fe_manager->proc~create_fe proc~create_bc_instances type_boundary_manager%create_bc_instances proc~create_bc_instances->proc~initialize_fe_manager proc~initialize_element_manager type_element_manager%initialize_element_manager proc~initialize_element_manager->proc~initialize_fe_manager proc~process_single_physics_bcs type_boundary_manager%process_single_physics_bcs proc~process_single_physics_bcs->proc~create_bc_instances proc~initialize_boundary_manager type_boundary_manager%initialize_boundary_manager proc~initialize_boundary_manager->proc~process_single_physics_bcs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine register_constructor ( id , constructor ) implicit none !> The VTK cell type ID to associate with the constructor. integer ( int32 ), intent ( in ) :: id !> A procedure pointer to the constructor function. procedure ( abst_fe_constructor ), intent ( in ), pointer :: constructor if ( associated ( fe_constructor ( id )% create )) then call global_logger % log_warning ( \"register_constructor: Overwriting constructor for ID = \" // to_string ( id )) end if fe_constructor ( id )% create => constructor end subroutine register_constructor","tags":"","url":"proc/register_constructor.html"},{"title":"get_env_string – FTDSS","text":"public  subroutine get_env_string(env_var_name, value, status) Gets the value of a specified environment variable as a string.\nIn an MPI environment, rank 0 reads the variable, which is then broadcast\nto all other ranks to ensure consistency. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: env_var_name The name of the environment variable to retrieve. character(len=:), intent(inout), allocatable :: value The retrieved value of the environment variable. An empty string is\nreturned if the variable is not set or is empty. integer(kind=int32), intent(inout), optional :: status Status code: 0 if successful, non-zero otherwise. Called by proc~~get_env_string~~CalledByGraph proc~get_env_string get_env_string proc~get_hostname get_hostname proc~get_hostname->proc~get_env_string proc~get_username get_username proc~get_username->proc~get_env_string proc~initialize_type_input type_input%initialize_type_input proc~initialize_type_input->proc~get_env_string proc~initialize_type_output type_output%initialize_type_output proc~initialize_type_output->proc~get_env_string proc~output_system_log output_system_log proc~output_system_log->proc~get_hostname proc~output_system_log->proc~get_username interface~output_system_log type_output%output_system_log interface~output_system_log->proc~output_system_log proc~finalize_type_ftdss finalize_type_ftdss proc~finalize_type_ftdss->interface~output_system_log interface~finalize_type_ftdss type_ftdss%finalize_type_ftdss interface~finalize_type_ftdss->proc~finalize_type_ftdss Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_env_string ( env_var_name , value , status ) implicit none !> The name of the environment variable to retrieve. character ( len =* ), intent ( in ) :: env_var_name !> The retrieved value of the environment variable. An empty string is !> returned if the variable is not set or is empty. character ( len = :), allocatable , intent ( inout ) :: value !> Status code: 0 if successful, non-zero otherwise. integer ( int32 ), intent ( inout ), optional :: status character ( len = 2048 ) :: buffer integer ( int32 ) :: nulpos integer ( int32 ) :: stat #ifdef _MPI integer ( int32 ) :: my_rank , ierr call MPI_Comm_rank ( MPI_COMM_WORLD , my_rank , ierr ) #endif if ( allocated ( value )) deallocate ( value ) ! Rank 0 reads the environment variable #ifdef _MPI if ( my_rank == 0 ) then #endif call get_environment_variable ( env_var_name , buffer , status = stat ) if ( stat /= 0 ) then buffer = '' if ( present ( status )) status = stat return end if #ifdef _MPI end if ! Broadcast the result to all ranks call MPI_Bcast ( buffer , len ( buffer ), MPI_CHARACTER , 0 , MPI_COMM_WORLD , ierr ) #endif ! Trim the result and allocate the output string to the correct length if ( len_trim ( buffer ) > 0 ) then nulpos = scan ( buffer , achar ( 0 )) if ( nulpos > 0 ) then allocate ( character ( len = nulpos - 1 ) :: value ) value = buffer ( 1 : nulpos - 1 ) else allocate ( character ( len = len_trim ( buffer )) :: value ) value = buffer ( 1 : len_trim ( buffer )) end if else value = '' end if end subroutine get_env_string","tags":"","url":"proc/get_env_string.html"},{"title":"calc_Kflh – FTDSS","text":"private  subroutine calc_Kflh(self, state, Kflh) Type Bound type_models_manager Arguments Type Intent Optional Attributes Name class( type_models_manager ), intent(in) :: self type( type_state ), intent(in) :: state real(kind=real64), intent(inout) :: Kflh Calls proc~~calc_kflh~~CallsGraph proc~calc_kflh type_models_manager%calc_Kflh calc_Kflh calc_Kflh proc~calc_kflh->calc_Kflh Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~calc_kflh~~CalledByGraph proc~calc_kflh type_models_manager%calc_Kflh proc~calc_kflh~2 type_physics_manager%calc_Kflh proc~calc_kflh~2->proc~calc_kflh proc~calc_k_wp_hydraulic calc_K_wP_hydraulic proc~calc_k_wp_hydraulic->proc~calc_kflh~2 proc~compute_advective_term_hydraulic compute_advective_term_hydraulic proc~compute_advective_term_hydraulic->proc~calc_kflh~2 proc~compute_diffusion_term_hydraulic compute_diffusion_term_hydraulic proc~compute_diffusion_term_hydraulic->proc~calc_kflh~2 interface~calc_k_wp_hydraulic type_hydraulic%calc_K_wP_hydraulic 