- 1 ; m = m + 12 end if a = floor ( real ( y , real64 ) / 10 0.0d0 ) b = 2 - a + floor ( real ( a , real64 ) / 4.0d0 ) jd = floor ( 36 5.25d0 * ( y + 4716 )) + floor ( 3 0.6001d0 * ( m + 1 )) + d_in + b - 152 4.5d0 end subroutine calc_julian_day","tags":"","url":"proc/calc_julian_day.html"},{"title":"calc_sun_coords – FTDSS","text":"private  subroutine calc_sun_coords(t, ecl_long, obliq, ra, dec) Calculates solar coordinates (Ecliptic Longitude, Obliquity, RA, Dec). Type Bound type_solar_system Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: t Julian Century real(kind=real64), intent(inout) :: ecl_long Ecliptic longitude real(kind=real64), intent(inout) :: obliq Obliquity real(kind=real64), intent(inout) :: ra Right Ascension real(kind=real64), intent(inout) :: dec Declination Called by proc~~calc_sun_coords~~CalledByGraph proc~calc_sun_coords type_solar_system%calc_sun_coords proc~compute_pos_kernel compute_pos_kernel proc~compute_pos_kernel->proc~calc_sun_coords proc~get_events_from_vals type_solar_system%get_events_from_vals proc~get_events_from_vals->proc~calc_sun_coords none~get_day_events type_solar_system%get_day_events none~get_day_events->proc~get_events_from_vals proc~get_events_from_dt type_solar_system%get_events_from_dt none~get_day_events->proc~get_events_from_dt proc~get_pos_from_dt type_solar_system%get_pos_from_dt proc~get_pos_from_dt->proc~compute_pos_kernel proc~get_pos_from_vals type_solar_system%get_pos_from_vals proc~get_pos_from_vals->proc~compute_pos_kernel proc~get_events_from_dt->none~get_day_events Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine calc_sun_coords ( t , ecl_long , obliq , ra , dec ) implicit none !> Julian Century real ( real64 ), intent ( in ) :: t !> Ecliptic longitude real ( real64 ), intent ( inout ) :: ecl_long !> Obliquity real ( real64 ), intent ( inout ) :: obliq !> Right Ascension real ( real64 ), intent ( inout ) :: ra !> Declination real ( real64 ), intent ( inout ) :: dec real ( real64 ) :: mean_long , mean_anom mean_long = mod ( 28 0.46646d0 + 3600 0.76983d0 * t , 36 0.0d0 ) if ( mean_long < 0.0d0 ) mean_long = mean_long + 36 0.0d0 mean_anom = mod ( 35 7.52911d0 + 3599 9.05029d0 * t , 36 0.0d0 ) mean_anom = mean_anom * DEG_TO_RAD ecl_long = mean_long + 1.914602d0 * sin ( mean_anom ) + & 0.019993d0 * sin ( 2.0d0 * mean_anom ) obliq = 2 3.439291d0 - 0.0130041d0 * t ra = atan2 ( cos ( obliq * DEG_TO_RAD ) * sin ( ecl_long * DEG_TO_RAD ), cos ( ecl_long * DEG_TO_RAD )) * RAD_TO_DEG if ( ra < 0.0d0 ) ra = ra + 36 0.0d0 dec = asin ( sin ( obliq * DEG_TO_RAD ) * sin ( ecl_long * DEG_TO_RAD )) * RAD_TO_DEG end subroutine calc_sun_coords","tags":"","url":"proc/calc_sun_coords.html"},{"title":"compute_pos_kernel – FTDSS","text":"private  subroutine compute_pos_kernel(self, y, m, d, utc_frac, el, az) Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(in) :: self The type_solar_system instance integer(kind=int32), intent(in) :: y Year integer(kind=int32), intent(in) :: m Month integer(kind=int32), intent(in) :: d Day real(kind=real64), intent(in) :: utc_frac UTC day fraction real(kind=real64), intent(inout) :: el Solar elevation (degrees) real(kind=real64), intent(inout) :: az Solar azimuth (degrees) Calls proc~~compute_pos_kernel~~CallsGraph proc~compute_pos_kernel compute_pos_kernel proc~calc_gmst type_solar_system%calc_gmst proc~compute_pos_kernel->proc~calc_gmst proc~calc_julian_day type_solar_system%calc_julian_day proc~compute_pos_kernel->proc~calc_julian_day proc~calc_sun_coords type_solar_system%calc_sun_coords proc~compute_pos_kernel->proc~calc_sun_coords Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_pos_kernel~~CalledByGraph proc~compute_pos_kernel compute_pos_kernel proc~get_pos_from_dt type_solar_system%get_pos_from_dt proc~get_pos_from_dt->proc~compute_pos_kernel proc~get_pos_from_vals type_solar_system%get_pos_from_vals proc~get_pos_from_vals->proc~compute_pos_kernel Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine compute_pos_kernel ( self , y , m , d , utc_frac , el , az ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( in ) :: self !> Year integer ( int32 ), intent ( in ) :: y !> Month integer ( int32 ), intent ( in ) :: m !> Day integer ( int32 ), intent ( in ) :: d !> UTC day fraction real ( real64 ), intent ( in ) :: utc_frac !> Solar elevation (degrees) real ( real64 ), intent ( inout ) :: el !> Solar azimuth (degrees) real ( real64 ), intent ( inout ) :: az real ( real64 ) :: jd , t , dec , lha_rad , latitude_rad , dec_rad , sin_el , cos_az real ( real64 ) :: gmst , ra , ecl_long , obliq ! 1. Julian Day (Calling nopass procedure) call self % calc_julian_day ( y , m , d , jd ) jd = jd + utc_frac ! 2. Julian Century t = ( jd - 245154 5.0d0 ) / 3652 5.0d0 ! 3. Solar Coordinates call self % calc_sun_coords ( t , ecl_long , obliq , ra , dec ) ! 4. Hour Angle Calculation call self % calc_gmst ( jd , gmst ) ! LHA = GMST + Longitude - RA lha_rad = ( gmst + self % longitude - ra ) lha_rad = mod ( lha_rad , 36 0.0d0 ) if ( lha_rad < 0.0d0 ) lha_rad = lha_rad + 36 0.0d0 lha_rad = lha_rad * DEG_TO_RAD latitude_rad = self % latitude * DEG_TO_RAD dec_rad = dec * DEG_TO_RAD ! 5. Elevation (Altitude) sin_el = sin ( latitude_rad ) * sin ( dec_rad ) + cos ( latitude_rad ) * cos ( dec_rad ) * cos ( lha_rad ) el = asin ( sin_el ) * RAD_TO_DEG ! 6. Azimuth ! cos(az) = (sin(dec) - sin(el)sin(lat)) / (cos(el)cos(lat)) cos_az = ( sin ( dec_rad ) - sin ( latitude_rad ) * sin_el ) / ( cos ( el * DEG_TO_RAD ) * cos ( latitude_rad )) if ( cos_az > 1.0d0 ) cos_az = 1.0d0 if ( cos_az < - 1.0d0 ) cos_az = - 1.0d0 az = acos ( cos_az ) * RAD_TO_DEG ! If sin(LHA) > 0, azimuth is to the West (afternoon) -> 360 - az if ( sin ( lha_rad ) > 0.0d0 ) az = 36 0.0d0 - az end subroutine compute_pos_kernel","tags":"","url":"proc/compute_pos_kernel.html"},{"title":"get_events_from_dt – FTDSS","text":"private  subroutine get_events_from_dt(self, dt, t_rise, t_set, t_noon, alt_noon, status) Type Bound type_solar_system Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(in) :: self The type_solar_system instance class( type_datetime ), intent(in) :: dt Datetime object real(kind=real64), intent(inout) :: t_rise Sunrise time (hour) real(kind=real64), intent(inout) :: t_set Sunset time (hour) real(kind=real64), intent(inout) :: t_noon Solar noon time (hour) real(kind=real64), intent(inout) :: alt_noon Solar altitude at noon (degrees) integer(kind=int32), intent(inout) :: status Status (0: Normal, 1: Midnight Sun, -1: Polar Night) Calls proc~~get_events_from_dt~~CallsGraph proc~get_events_from_dt type_solar_system%get_events_from_dt none~get_day_events type_solar_system%get_day_events proc~get_events_from_dt->none~get_day_events proc~get_datetime_components type_datetime%get_datetime_components proc~get_events_from_dt->proc~get_datetime_components none~get_day_events->proc~get_events_from_dt proc~get_events_from_vals type_solar_system%get_events_from_vals none~get_day_events->proc~get_events_from_vals proc~calc_julian_day type_solar_system%calc_julian_day proc~get_events_from_vals->proc~calc_julian_day proc~calc_sun_coords type_solar_system%calc_sun_coords proc~get_events_from_vals->proc~calc_sun_coords Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~get_events_from_dt~~CalledByGraph proc~get_events_from_dt type_solar_system%get_events_from_dt none~get_day_events type_solar_system%get_day_events proc~get_events_from_dt->none~get_day_events none~get_day_events->proc~get_events_from_dt Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_events_from_dt ( self , dt , t_rise , t_set , t_noon , alt_noon , status ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( in ) :: self !> Datetime object class ( type_datetime ), intent ( in ) :: dt !> Sunrise time (hour) real ( real64 ), intent ( inout ) :: t_rise !> Sunset time (hour) real ( real64 ), intent ( inout ) :: t_set !> Solar noon time (hour) real ( real64 ), intent ( inout ) :: t_noon !> Solar altitude at noon (degrees) real ( real64 ), intent ( inout ) :: alt_noon !> Status (0: Normal, 1: Midnight Sun, -1: Polar Night) integer ( int32 ), intent ( inout ) :: status integer ( int32 ) :: y , m , d , h , min , sec , tz_min real ( real64 ) :: tz_hr ! Extract components from datetime call dt % get ( y , m , d , h , min , sec , tz_min ) tz_hr = real ( tz_min , real64 ) / 6 0.0d0 ! Delegate to values implementation call self % get_day_events ( y , m , d , tz_hr , t_rise , t_set , t_noon , alt_noon , status ) end subroutine get_events_from_dt","tags":"","url":"proc/get_events_from_dt.html"},{"title":"get_events_from_vals – FTDSS","text":"private  subroutine get_events_from_vals(self, year, month, day, timezone, t_rise, t_set, t_noon, alt_noon, status) Type Bound type_solar_system Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(in) :: self The type_solar_system instance integer(kind=int32), intent(in) :: year Year integer(kind=int32), intent(in) :: month Month integer(kind=int32), intent(in) :: day Day real(kind=real64), intent(in) :: timezone Timezone offset (e.g., 9.0) real(kind=real64), intent(inout) :: t_rise Sunrise time (hour) real(kind=real64), intent(inout) :: t_set Sunset time (hour) real(kind=real64), intent(inout) :: t_noon Solar noon time (hour) real(kind=real64), intent(inout) :: alt_noon Solar altitude at noon (degrees) integer(kind=int32), intent(inout) :: status Status (0: Normal, 1: Midnight Sun, -1: Polar Night) Calls proc~~get_events_from_vals~~CallsGraph proc~get_events_from_vals type_solar_system%get_events_from_vals proc~calc_julian_day type_solar_system%calc_julian_day proc~get_events_from_vals->proc~calc_julian_day proc~calc_sun_coords type_solar_system%calc_sun_coords proc~get_events_from_vals->proc~calc_sun_coords Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~get_events_from_vals~~CalledByGraph proc~get_events_from_vals type_solar_system%get_events_from_vals none~get_day_events type_solar_system%get_day_events none~get_day_events->proc~get_events_from_vals proc~get_events_from_dt type_solar_system%get_events_from_dt none~get_day_events->proc~get_events_from_dt proc~get_events_from_dt->none~get_day_events Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_events_from_vals ( self , year , month , day , timezone , t_rise , t_set , t_noon , alt_noon , status ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( in ) :: self !> Year integer ( int32 ), intent ( in ) :: year !> Month integer ( int32 ), intent ( in ) :: month !> Day integer ( int32 ), intent ( in ) :: day !> Timezone offset (e.g., 9.0) real ( real64 ), intent ( in ) :: timezone !> Sunrise time (hour) real ( real64 ), intent ( inout ) :: t_rise !> Sunset time (hour) real ( real64 ), intent ( inout ) :: t_set !> Solar noon time (hour) real ( real64 ), intent ( inout ) :: t_noon !> Solar altitude at noon (degrees) real ( real64 ), intent ( inout ) :: alt_noon !> Status (0: Normal, 1: Midnight Sun, -1: Polar Night) integer ( int32 ), intent ( inout ) :: status real ( real64 ) :: jd , t , ecl , obl , ra , dec , gmst real ( real64 ) :: eq_time , sun_noon_utc , ha_deg , cos_ha real ( real64 ) :: zenith_rad , y_val , mean_l , mean_a real ( real64 ) :: latitude_rad , dec_rad , sin_alt_noon status = 0 t_rise = 0.0d0 t_set = 0.0d0 t_noon = 0.0d0 alt_noon = 0.0d0 ! Calculate based on Solar Noon call self % calc_julian_day ( year , month , day , jd ) t = ( jd - 245154 5.0d0 ) / 3652 5.0d0 call self % calc_sun_coords ( t , ecl , obl , ra , dec ) ! Equation of Time mean_l = mod ( 28 0.46646d0 + 3600 0.76983d0 * t , 36 0.0d0 ) * DEG_TO_RAD mean_a = mod ( 35 7.52911d0 + 3599 9.05029d0 * t , 36 0.0d0 ) * DEG_TO_RAD y_val = tan ( obl * DEG_TO_RAD / 2.0d0 ) ** 2 eq_time = 4.0d0 * RAD_TO_DEG * ( & y_val * sin ( 2.0d0 * mean_l ) - & 2.0d0 * 0.01671d0 * sin ( mean_a ) + & 4.0d0 * 0.01671d0 * y_val * sin ( mean_a ) * cos ( 2.0d0 * mean_l ) - & 0.5d0 * y_val ** 2 * sin ( 4.0d0 * mean_l ) - & 1.25d0 * 0.01671d0 ** 2 * sin ( 2.0d0 * mean_a )) ! --- Solar Noon (UTC) --- sun_noon_utc = ( 72 0.0d0 - 4.0d0 * self % longitude - eq_time ) / 6 0.0d0 t_noon = mod ( sun_noon_utc + timezone , 2 4.0d0 ) if ( t_noon < 0.0d0 ) t_noon = t_noon + 2 4.0d0 ! --- Solar Altitude at Noon --- ! Hour Angle is 0 at solar noon latitude_rad = self % latitude * DEG_TO_RAD dec_rad = dec * DEG_TO_RAD ! sin(h) = sin(phi)sin(delta) + cos(phi)cos(delta)*cos(0) sin_alt_noon = sin ( latitude_rad ) * sin ( dec_rad ) + cos ( latitude_rad ) * cos ( dec_rad ) alt_noon = asin ( sin_alt_noon ) * RAD_TO_DEG ! --- Sunrise / Sunset --- ! Zenith distance = 90 deg + radius + refraction + dip zenith_rad = ( 9 0.8333d0 + self % dip_deg ) * DEG_TO_RAD cos_ha = ( cos ( zenith_rad ) - sin ( latitude_rad ) * sin ( dec_rad )) / & ( cos ( latitude_rad ) * cos ( dec_rad )) if ( cos_ha > 1.0d0 ) then status = - 1 ! Polar Night return else if ( cos_ha < - 1.0d0 ) then status = 1 ! Midnight Sun (White Night) return end if ha_deg = acos ( cos_ha ) * RAD_TO_DEG t_rise = sun_noon_utc - ha_deg / 1 5.0d0 + timezone t_set = sun_noon_utc + ha_deg / 1 5.0d0 + timezone t_rise = mod ( t_rise , 2 4.0d0 ) if ( t_rise < 0.0d0 ) t_rise = t_rise + 2 4.0d0 t_set = mod ( t_set , 2 4.0d0 ) if ( t_set < 0.0d0 ) t_set = t_set + 2 4.0d0 end subroutine get_events_from_vals","tags":"","url":"proc/get_events_from_vals.html"},{"title":"get_pos_from_dt – FTDSS","text":"private  subroutine get_pos_from_dt(self, dt, elevation, azimuth) Type Bound type_solar_system Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(in) :: self The type_solar_system instance class( type_datetime ), intent(in) :: dt Datetime object real(kind=real64), intent(inout) :: elevation Solar elevation (degrees) real(kind=real64), intent(inout) :: azimuth Solar azimuth (degrees) Calls proc~~get_pos_from_dt~~CallsGraph proc~get_pos_from_dt type_solar_system%get_pos_from_dt proc~compute_pos_kernel compute_pos_kernel proc~get_pos_from_dt->proc~compute_pos_kernel proc~get_datetime_components type_datetime%get_datetime_components proc~get_pos_from_dt->proc~get_datetime_components proc~calc_gmst type_solar_system%calc_gmst proc~compute_pos_kernel->proc~calc_gmst proc~calc_julian_day type_solar_system%calc_julian_day proc~compute_pos_kernel->proc~calc_julian_day proc~calc_sun_coords type_solar_system%calc_sun_coords proc~compute_pos_kernel->proc~calc_sun_coords Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_pos_from_dt ( self , dt , elevation , azimuth ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( in ) :: self !> Datetime object class ( type_datetime ), intent ( in ) :: dt !> Solar elevation (degrees) real ( real64 ), intent ( inout ) :: elevation !> Solar azimuth (degrees) real ( real64 ), intent ( inout ) :: azimuth integer ( int32 ) :: y , m , d , h , min , sec , tz_min real ( real64 ) :: tz_hr , time_frac call dt % get ( y , m , d , h , min , sec , tz_min ) tz_hr = real ( tz_min , real64 ) / 6 0.0d0 ! Calculate day fraction in UTC (0.0 - 1.0) time_frac = ( real ( h , real64 ) + real ( min , real64 ) / 6 0.0d0 + & real ( sec , real64 ) / 360 0.0d0 ) - tz_hr time_frac = time_frac / 2 4.0d0 call compute_pos_kernel ( self , y , m , d , time_frac , elevation , azimuth ) end subroutine get_pos_from_dt","tags":"","url":"proc/get_pos_from_dt.html"},{"title":"get_pos_from_vals – FTDSS","text":"private  subroutine get_pos_from_vals(self, year, month, day, hour, timezone, elevation, azimuth) Type Bound type_solar_system Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(in) :: self The type_solar_system instance integer(kind=int32), intent(in) :: year Year integer(kind=int32), intent(in) :: month Month integer(kind=int32), intent(in) :: day Day real(kind=real64), intent(in) :: hour Local time (e.g., 12.5 for 12:30) real(kind=real64), intent(in) :: timezone Timezone offset (e.g., 9.0 for JST) real(kind=real64), intent(inout) :: elevation Solar elevation (degrees) real(kind=real64), intent(inout) :: azimuth Solar azimuth (degrees) Calls proc~~get_pos_from_vals~~CallsGraph proc~get_pos_from_vals type_solar_system%get_pos_from_vals proc~compute_pos_kernel compute_pos_kernel proc~get_pos_from_vals->proc~compute_pos_kernel proc~calc_gmst type_solar_system%calc_gmst proc~compute_pos_kernel->proc~calc_gmst proc~calc_julian_day type_solar_system%calc_julian_day proc~compute_pos_kernel->proc~calc_julian_day proc~calc_sun_coords type_solar_system%calc_sun_coords proc~compute_pos_kernel->proc~calc_sun_coords Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine get_pos_from_vals ( self , year , month , day , hour , timezone , elevation , azimuth ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( in ) :: self !> Year integer ( int32 ), intent ( in ) :: year !> Month integer ( int32 ), intent ( in ) :: month !> Day integer ( int32 ), intent ( in ) :: day !> Local time (e.g., 12.5 for 12:30) real ( real64 ), intent ( in ) :: hour !> Timezone offset (e.g., 9.0 for JST) real ( real64 ), intent ( in ) :: timezone !> Solar elevation (degrees) real ( real64 ), intent ( inout ) :: elevation !> Solar azimuth (degrees) real ( real64 ), intent ( inout ) :: azimuth real ( real64 ) :: time_frac ! Calculate day fraction in UTC time_frac = ( hour - timezone ) / 2 4.0d0 call compute_pos_kernel ( self , year , month , day , time_frac , elevation , azimuth ) end subroutine get_pos_from_vals","tags":"","url":"proc/get_pos_from_vals.html"},{"title":"initialize_solar_system – FTDSS","text":"private  subroutine initialize_solar_system(self, latitude, longitude, altitude_m) Initializes the solar system with location data. Type Bound type_solar_system Arguments Type Intent Optional Attributes Name class( type_solar_system ), intent(inout) :: self The type_solar_system instance real(kind=real64), intent(in) :: latitude Latitude in degrees real(kind=real64), intent(in) :: longitude Longitude in degrees real(kind=real64), intent(in) :: altitude_m Altitude in meters Source Code subroutine initialize_solar_system ( self , latitude , longitude , altitude_m ) implicit none !> The type_solar_system instance class ( type_solar_system ), intent ( inout ) :: self !> Latitude in degrees real ( real64 ), intent ( in ) :: latitude !> Longitude in degrees real ( real64 ), intent ( in ) :: longitude !> Altitude in meters real ( real64 ), intent ( in ) :: altitude_m self % latitude = latitude self % longitude = longitude self % altitude_m = altitude_m ! Approximation for dip of horizon: 0.0347 * sqrt(h) self % dip_deg = 0.0347d0 * sqrt ( max ( 0.0d0 , altitude_m )) end subroutine initialize_solar_system","tags":"","url":"proc/initialize_solar_system.html"},{"title":"reset_physics_info – FTDSS","text":"private  subroutine reset_physics_info(self) Type Bound type_physics_info Arguments Type Intent Optional Attributes Name class( type_physics_info ), intent(inout) :: self Calls proc~~reset_physics_info~~CallsGraph proc~reset_physics_info type_physics_info%reset_physics_info deallocate_array deallocate_array proc~reset_physics_info->deallocate_array Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~reset_physics_info~~CalledByGraph proc~reset_physics_info type_physics_info%reset_physics_info proc~get_density_info_material_settings get_density_info_material_se