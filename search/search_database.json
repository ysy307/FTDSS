 self % num_nodes_in_cell < 0 ) then self % num_nodes_in_cell = num_nodes_in_cell end if end subroutine type_vtk_cell_set module subroutine get_active_region_info ( self , unique_ids , target_dim ) implicit none class ( Type_VTK ), intent ( in ) :: self !! VTK data integer ( int32 ), allocatable , intent ( inout ) :: unique_ids (:) integer ( int32 ), intent ( in ), optional :: target_dim ! --- ローカル変数 --- integer ( int32 ) :: i_cell , count , dim integer ( int32 ), allocatable :: collected_ids (:) integer ( int32 ) :: max_dim_local max_dim_local = 0 count = 0 ! --- ステップ1: 収集する次元を決定 --- if ( present ( target_dim )) then max_dim_local = target_dim else ! 指定がなければ自プロセス内で最大次元を判定 do i_cell = 1 , self % num_total_cells max_dim_local = max ( max_dim_local , self % CELLS ( i_cell )% get_dimension ()) end do if ( max_dim_local <= 0 ) then allocate ( unique_ids ( 0 )) return end if end if ! --- ステップ2: 指定次元のCellEntityIdを収集 --- allocate ( collected_ids ( self % num_total_cells )) do i_cell = 1 , self % num_total_cells dim = self % CELLS ( i_cell )% get_dimension () if ( dim == max_dim_local ) then count = count + 1 collected_ids ( count ) = self % CELLS ( i_cell )% cell_entity_id end if end do ! --- ステップ3: ユニークなIDのみ抽出 --- if ( count > 0 ) then call unique ( collected_ids ( 1 : count ), unique_ids ) else allocate ( unique_ids ( 0 )) end if deallocate ( collected_ids ) end subroutine get_active_region_info end submodule core_vtk_base","tags":"","url":"sourcefile/vtk_base.f90.html"},{"title":"constants_solver.F90 – FTDSS","text":"Files dependent on this one sourcefile~~constants_solver.f90~~AfferentGraph sourcefile~constants_solver.f90 constants_solver.F90 sourcefile~constants.f90 constants.F90 sourcefile~constants.f90->sourcefile~constants_solver.f90 sourcefile~constants_utils.f90 constants_utils.F90 sourcefile~constants.f90->sourcefile~constants_utils.f90 sourcefile~constants_utils.f90->sourcefile~constants_solver.f90 sourcefile~config_bc.f90 config_bc.F90 sourcefile~config_bc.f90