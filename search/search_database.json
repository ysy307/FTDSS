are\ngiven different colours to make them easier to distinguish in\nlarge graphs. private module subroutine zero_row_dia(self, row, row_block) Implementation → Arguments Type Intent Optional Attributes Name class( type_matrix_dia ), intent(inout) :: self integer(kind=int32), intent(in) :: row integer(kind=int32), intent(in), optional :: row_block","tags":"","url":"interface/zero_row_dia.html"},{"title":"create_boundary_conditions – FTDSS","text":"public  function create_boundary_conditions(config_bc) result(bc) 境界条件オブジェクトのファクトリ関数 Arguments Type Intent Optional Attributes Name type( type_config_bc ), intent(in) :: config_bc Return Value class( abst_bc ), allocatable Calls proc~~create_boundary_conditions~~CallsGraph proc~create_boundary_conditions create_boundary_conditions interface~initialize_bc abst_bc%initialize_bc proc~create_boundary_conditions->interface~initialize_bc proc~raise_error raise_error proc~create_boundary_conditions->proc~raise_error proc~initialize_bc initialize_bc interface~initialize_bc->proc~initialize_bc proc~replace_placeholder replace_placeholder proc~raise_error->proc~replace_placeholder strip strip proc~raise_error->strip to_string to_string proc~raise_error->to_string proc~copy_config_bc type_config_bc%copy_config_bc proc~initialize_bc->proc~copy_config_bc proc~replace_placeholder->strip Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~create_boundary_conditions~~CalledByGraph proc~create_boundary_conditions create_boundary_conditions proc~create_bc_instances type_boundary_manager%create_bc_instances proc~create_bc_instances->proc~create_boundary_conditions proc~process_single_physics_bcs type_boundary_manager%process_single_physics_bcs proc~process_single_physics_bcs->proc~create_bc_instances proc~initialize_boundary_manager type_boundary_manager%initialize_boundary_manager proc~initialize_boundary_manager->proc~process_single_physics_bcs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code function create_boundary_conditions ( config_bc ) result ( bc ) implicit none type ( type_config_bc ), intent ( in ) :: config_bc class ( abst_bc ), allocatable :: bc ! 1. IDに基づいて適切なクラスを割り当てる (Allocate) !    ※ 熱(Thermal)も水(Hydraulic)も、数学的性質が同じなら同じ型を使う if ( config_bc % bc_kind == THERMAL_BC_TYPES % DIRICHLET . or . & config_bc % bc_kind == HYDRAULIC_BC_TYPES % DIRICHLET ) then allocate ( type_bc_dirichlet :: bc ) else if ( config_bc % bc_kind == THERMAL_BC_TYPES % NEUMANN . or . & config_bc % bc_kind == THERMAL_BC_TYPES % FLUX . or . & config_bc % bc_kind == HYDRAULIC_BC_TYPES % NEUMANN . or . & config_bc % bc_kind == HYDRAULIC_BC_TYPES % FLUX . or . & config_bc % bc_kind == HYDRAULIC_BC_TYPES % SEEPAGE ) then allocate ( type_bc_neumann :: bc ) else if ( config_bc % bc_kind == THERMAL_BC_TYPES % ROBIN . or . & config_bc % bc_kind == THERMAL_BC_TYPES % CONVECTIVE . or . & config_bc % bc_kind == THERMAL_BC_TYPES % RADIATION ) then allocate ( type_bc_robin :: bc ) else if ( config_bc % bc_kind == THERMAL_BC_TYPES % ADIABATIC . or . & config_bc % bc_kind == HYDRAULIC_BC_TYPES % IMPERMEABLE ) then allocate ( type_bc_zero_flux :: bc ) else if ( config_bc % bc_kind == THERMAL_BC_TYPES % FREE ) then allocate ( type_bc_neumann :: bc ) else call raise_error ( ERROR_CODES % INVALID_BC_TYPE ) end if ! 2. 共通初期化メソッドを呼ぶ !    ここでデータの読み込み、時間係数の計算準備などが行われる if ( allocated ( bc )) then call bc % initialize ( config_bc ) ! 初期化に失敗していれば破棄する安全策を入れる場合 ! if (.not. bc%initialized) deallocate(bc) end if end function create_boundary_conditions","tags":"","url":"proc/create_boundary_conditions.html"},{"title":"replace_placeholder – FTDSS","text":"private pure function replace_placeholder(tmpl, val) result(res) Simple Pure placeholder replacer for '{}'\nReturns an allocated string of the exact required length. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: tmpl character(len=*), intent(in) :: val Return Value character(len=:), allocatable Calls proc~~replace_placeholder~~CallsGraph proc~replace_placeholder replace_placeholder strip strip proc~replace_placeholder->strip Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them eas