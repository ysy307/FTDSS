K_wP * grad_P % y water_flux % z = 0.0d0 case ( COMP_TYPE_2D_XZ ) water_flux % x = - K_wT * grad_T % x - K_wP * grad_P % x water_flux % y = 0.0d0 water_flux % z = - K_wT * grad_T % z - K_wP * grad_P % z - gravity_term ! Zを鉛直と仮定 case ( COMP_TYPE_3D ) water_flux % x = - K_wT * grad_T % x - K_wP * grad_P % x water_flux % y = - K_wT * grad_T % y - K_wP * grad_P % y water_flux % z = - K_wT * grad_T % z - K_wP * grad_P % z - gravity_term ! Zを鉛直と仮定 end select end subroutine calc_water_flux_ftdss","tags":"","url":"proc/calc_water_flux_ftdss.html"},{"title":"solve_ftdss – FTDSS","text":"module subroutine solve_ftdss(self) Interface → Arguments Type Intent Optional Attributes Name class( type_ftdss ), intent(inout) :: self Calls proc~~solve_ftdss~~CallsGraph proc~solve_ftdss solve_ftdss none~start~3 type_profiler%start proc~solve_ftdss->none~start~3 proc~check_solver abst_solver%check_solver proc~solve_ftdss->proc~check_solver proc~get_underlying_matrix type_jacobian_matrix%get_underlying_matrix proc~solve_ftdss->proc~get_underlying_matrix proc~get_underlying_vector type_residual_vector%get_underlying_vector proc~solve_ftdss->proc~get_underlying_vector solve solve proc~solve_ftdss->solve proc~start_profile_by_id type_profiler%start_profile_by_id none~start~3->proc~start_profile_by_id proc~start_profile_by_name type_profiler%start_profile_by_name none~start~3->proc~start_profile_by_name strip strip proc~check_solver->strip proc~get_current_wall_time type_profiler%get_current_wall_time proc~start_profile_by_id->proc~get_current_wall_time proc~start_profile_by_name->proc~start_profile_by_id proc~start_profile_by_name->strip proc~get_profiler_id type_profiler%get_profiler_id proc~start_profile_by_name->proc~get_profiler_id proc~raise_error raise_error proc~start_profile_by_name->proc~raise_error proc~match_profiler_section_label type_profiler_section%match_profiler_section_label proc~get_profiler_id->proc~match_profiler_section_label proc~raise_error->strip proc~replace_placehold