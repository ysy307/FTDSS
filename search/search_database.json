material_id, state) Implementation → Arguments Type Intent Optional Attributes Name class( type_thermal ), intent(in) :: self integer(kind=int32), intent(in) :: material_id type( type_state ), intent(inout) :: state","tags":"","url":"interface/update_water_phases_thermal.html"},{"title":"calc_kr_mvg – FTDSS","text":"subroutine calc_kr_mvg(theta_s, theta_r, alpha1, n1, m1, l, h_crit, h, kr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: theta_s real(kind=real64), intent(in) :: theta_r real(kind=real64), intent(in) :: alpha1 real(kind=real64), intent(in) :: n1 real(kind=real64), intent(in) :: m1 real(kind=real64), intent(in) :: l real(kind=real64), intent(in) :: h_crit real(kind=real64), intent(in) :: h real(kind=real64), intent(inout) :: kr Called by proc~~calc_kr_mvg~~CalledByGraph proc~calc_kr_mvg calc_kr_mvg proc~calc_kr_base_mvg calc_kr_base_mvg proc~calc_kr_base_mvg->proc~calc_kr_mvg interface~calc_kr_base_mvg type_hcf_base_mvg%calc_kr_base_mvg interface~calc_kr_base_mvg->proc~calc_kr_base_mvg Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine calc_kr_mvg ( theta_s , theta_r , alpha1 , n1 , m1 , l , h_crit , h , kr ) implicit none real ( real64 ), intent ( in ) :: theta_s real ( real64 ), intent ( in ) :: theta_r real ( real64 ), intent ( in ) :: alpha1 real ( real64 ), intent ( in ) :: n1 real ( real64 ), intent ( in ) :: m1 real ( real64 ), intent ( in ) :: l real ( real64 ), intent ( in ) :: h_crit real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: kr real ( real64 ) :: Se , Se_crit real ( real64 ) :: numer , denom real ( real64 ) :: term_numer , term_denom if ( h < h_crit ) then ! 1. 通常の有効飽和度 Se(h) と Se(h_crit) を計算 !    (theta_s - theta_r) で割る前の値でも比を取れば同じなので、直接 (1+|ah|&#94;n)&#94;-m を使う Se = ( 1.0d0 + abs ( alpha1 * h ) ** n1 ) ** ( - m1 ) Se_crit = ( 1.0d0 + abs ( alpha1 * h_crit ) ** n1 ) ** ( - m1 ) ! 2. Mualem積分の項 (分子: 現在のh) !    Term = [ 1 - (1 - Se&#94;(1/m))&#94;m ]&#94;2 term_numer = 1.0d0 - Se ** ( 1.0d0 / m1 ) if ( term_numer < 0.0d0 ) term_numer = 0.0d0 ! ガード numer = ( 1.0d0 - term_numer ** m1 ) ** 2.0d0 ! 3. Mualem積分の項 (分母: h_crit での正規化用) term_denom = 1.0d0 - Se_crit ** ( 1.0d0 / m1 ) if ( term_denom < 0.0d0 ) term_denom = 0.0d0 ! ガード denom = ( 1.0d0 - term_denom ** m1 ) ** 2.0d0 ! 4. 結合 (Se/Se_crit)&#94;l * (Numer/Denom) kr = ( Se / Se_crit ) ** l * ( numer / denom ) else kr = 1.0d0 end if end subroutine calc_kr_mvg","tags":"","url":"proc/calc_kr_mvg.html"},{"title":"vtk_finalize – FTDSS","text":"interface Called by interface~~vtk_finalize~~CalledByGraph interface~vtk_finalize vtk_finalize proc~finalize_vtk_object finalize_vtk_object proc~finalize_vtk_object->interface~vtk_finalize proc~type_vtk_vtk_initialize type_vtk_vtk_initialize proc~type_vtk_vtk_initialize->interface~vtk_finalize interface~type_vtk_vtk_initialize type_vtk%type_vtk_vtk_initialize interface~type_vtk_vtk_initialize->proc~type_vtk_vtk_initialize proc~initialize_type_input_geometry initialize_type_input_geometry proc~initialize_type_input_geometry->interface~type_vtk_vtk_initialize interface~initialize_type_input_geometry type_input_geometry%initialize_type_input_geometry interface~initialize_type_input_geometry->proc~initialize_type_input_geometry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subrou