32), intent(in), optional :: row (:) The node-level row indices defining the sparsity pattern. integer(kind=int32), intent(in), optional :: col (:) The node-level column indices defining the sparsity pattern. integer(kind=int32), intent(in), optional :: row_blocks The number of row blocks. integer(kind=int32), intent(in), optional :: col_blocks The number of column blocks. module subroutine scale_coo (self, op, alpha) Interface → Scales all stored values in the matrix by a scalar factor vector. Arguments Type Intent Optional Attributes Name class( type_matrix_coo ), intent(inout) :: self The COO matrix object. integer(kind=int32), intent(in) :: op The operation to perform type( type_vector_dp ), intent(in) :: alpha The scaling vector (derived from diagonal). module subroutine set_all_coo (self, op, value) Interface → Sets all stored non-zero values in the matrix to a single scalar value. Arguments Type Intent Optional Attributes Name class( type_matrix_coo ), intent(inout) :: self The COO matrix object. integer(kind=int32), intent(in) :: op The operation to perform real(kind=real64), intent(in) :: value The scalar value to assign to all non-zero entries. module subroutine set_row_coo (self, op, row, value, row_block) Interface → Sets all non-zero entries in a specified row to a single scalar value.\nNote: This is an inefficient O(nnz) operation for the COO format. Arguments Type Intent Optional Attributes Name class( type_matrix_coo ), intent(inout) :: self The COO matrix object. integer(kind=int32), intent(in) :: op The operation to perform integer(kind=int32), intent(in) :: row The 1-based node index for the row. real(kind=real64), intent(in) :: value The scalar value to assign. integer(kind=int32), intent(in), optional :: row_block The block row index. module subroutine set_value_block_coo (self, op, row, col, row_block, col_block, value) Interface → Arguments Type Intent Optional Attributes Name class( type_matrix_coo ), intent(inout) :: self The COO matrix obje