dt になる) call self % controls % update ( is_step_converged ) if ( is_step_converged ) then ! [成功時] ! 3. 物理量の履歴のみをシフトする call self % shift () ! 4. 更新後の時刻で出力判定 call self % update_variables () call self % output_fields () call self % output_history () else ! [失敗] やり直し処理 write ( * , '(\"   [WARNING] Step Failed. Retrying with smaller dt...\")' ) call self % controls % update ( is_step_converged ) cycle time_loop end if end do time_loop end subroutine run_ftdss","tags":"","url":"proc/run_ftdss.html"},{"title":"solve_time_step_check_convergence_ftdss – FTDSS","text":"module subroutine solve_time_step_check_convergence_ftdss(self) Interface → Arguments Type Intent Optional Attributes Name class( type_ftdss ), intent(inout), target :: self Calls proc~~solve_time_step_check_convergence_ftdss~~CallsGraph proc~solve_time_step_check_convergence_ftdss solve_time_step_check_convergence_ftdss deallocate_array deallocate_array proc~solve_time_step_check_convergence_ftdss->deallocate_array has_nan has_nan proc~solve_time_step_check_convergence_ftdss->has_nan interface~get_variable_increment_ftdss type_ftdss%get_variable_increment_ftdss proc~solve_time_step_check_convergence_ftdss->interface~get_variable_increment_ftdss interface~get_variable_residual_ftdss type_ftdss%get_variable_residual_ftdss proc~solve_time_step_check_convergence_ftdss->interface~get_variable_residual_ftdss proc~check_convergence type_iteration%check_convergence proc~solve_time_step_check_convergence_ftdss->proc~check_convergence proc~get_current_residual_norm_iteration type_iteration%get_current_residual_norm_iteration proc~solve_time_step_check_convergence_ftdss->proc~get_current_residual_norm_iteration proc~get_nonlinear_iter type_iteration%get_nonlinear_iter proc~solve_time_step_check_convergence_ftdss->proc~get_nonlinear_iter proc~has_diverged_iteration type_iteration%has_diverged_iteration proc~solve_time_step_check_convergence_ftdss->proc~has_diverged_iteration proc~is_compute_newton_method_iteration type_it