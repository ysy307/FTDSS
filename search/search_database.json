it ** ( 1.0d0 / m1 ) if ( term_denom < 0.0d0 ) term_denom = 0.0d0 ! ガード denom = ( 1.0d0 - term_denom ** m1 ) ** 2.0d0 ! 4. 結合 (Se/Se_crit)&#94;l * (Numer/Denom) kr = ( Se / Se_crit ) ** l * ( numer / denom ) else kr = 1.0d0 end if end subroutine calc_kr_mvg !---------------------------------------------------------------------------------------------------- ! Wrapper of calculating kr for Modified van-Genuchten model bounding different derived types !---------------------------------------------------------------------------------------------------- module subroutine calc_kr_base_mvg ( self , h , kr ) implicit none class ( type_hcf_base_mvg ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: kr associate ( params => self % parent % params ) call calc_kr_mvg ( params % theta_s , params % theta_r , params % alpha1 , params % n1 , params % m1 , params % l , params % h_crit , h , kr ) end associate end subroutine calc_kr_base_mvg end submodule hcf_mvg","tags":"","url":"sourcefile/hcf_mvg.f90.html"},{"title":"vtk_wrapper.F90 – FTDSS","text":"Files dependent on this one sourcefile~~vtk_wrapper.f90~~AfferentGraph sourcefile~vtk_wrapper.f90 vtk_wrapper.F90 sourcefile~vtk.f90 vtk.F90 sourcefile~vtk.f90->sourcefile~vtk_wrapper.f90 sourcefile~interop.f90 interop.F90 sourcefile~interop.f90->sourcefile~vtk.f90 sourcefile~vtk_base.f90 vtk_base.F90 sourcefile~vtk_base.f90->sourcefile~vtk.f90 sourcefile~vtk_initialize.f90 vtk_initialize.F90 sourcefile~vtk_initialize.f90->sourcefile~vtk.f90 sourcefile~vtu_initialize.f90 vtu_initialize.F90 sourcefile~vtu_initialize.f90->sourcefile~vtk.f90 sourcefile~core.f90 core.F90 sourcefile~core.f90->sourcefile~interop.f90 sourcefile~ats.f90 ats.F90 sourcefile~ats.f90->sourcefile~core.f90 sourcefile~input.f90 input.F90 sourcefile~ats.f90->sourcefile~input.f90 sourcefile~basic_interface.f90 basic_interface.F90 sourcefile~basic_interface.f90->sourcefile~core.f90 sourcefile~input_base.f90 input_base.F90 