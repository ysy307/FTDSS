/ ( n1 * sqrt_2 ) + n1 / sqrt_2 )) ** 2 else kr = 1.0d0 end if end subroutine calc_kr_ko module subroutine calc_kr_base_ko ( self , h , kr ) implicit none class ( type_hcf_base_ko ), intent ( in ) :: self real ( real64 ), intent ( in ) :: h real ( real64 ), intent ( inout ) :: kr associate ( params => self % parent % params ) call calc_kr_ko ( params % alpha1 , params % n1 , params % l , h , kr ) end associate end subroutine calc_kr_base_ko end submodule hcf_ko","tags":"","url":"sourcefile/hcf_ko.f90.html"},{"title":"initial_manager.F90 – FTDSS","text":"This file depends on sourcefile~~initial_manager.f90~~EfferentGraph sourcefile~initial_manager.f90 initial_manager.F90 sourcefile~core.f90 core.F90 sourcefile~initial_manager.f90->sourcefile~core.f90 sourcefile~domain.f90 domain.F90 sourcefile~initial_manager.f90->sourcefile~domain.f90 sourcefile~initial_interface.f90 initial_interface.F90 sourcefile~initial_manager.f90->sourcefile~initial_interface.f90 sourcefile~input.f90 input.F90 sourcefile~initial_manager.f90->sourcefile~input.f90 sourcefile~constants.f90 constants.F90 sourcefile~core.f90->sourcefile~constants.f90 sourcefile~interop.f90 interop.F90 sourcefile~core.f90->sourcefile~interop.f90 sourcefile~memory.f90 memory.F90 sourcefile~core.f90->sourcefile~memory.f90 sourcefile~types.f90 types.F90 sourcefile~core.f90->sourcefile~types.f90 sourcefile~utils.f90 utils.F90 sourcefile~core.f90->sourcefile~utils.f90 sourcefile~validation.f90 validation.F90 sourcefile~core.f90->sourcefile~validation.f90 sourcefile~adjacency.f90 adjacency.F90 sourcefile~domain.f90->sourcefile~adjacency.f90 sourcefile~domain_manager.f90 domain_manager.F90 sourcefile~domain.f90->sourcefile~domain_manager.f90 sourcefile~fe.f90 fe.F90 sourcefile~domain.f90->sourcefile~fe.f90 sourcefile~multicoloring.f90 multicoloring.F90 sourcefile~domain.f90->sourcefile~multicoloring.f90 sourcefile~initial_interface.f90->sourcefile~core.f90 sourcefile~initial_interface.f90->sourcefile~input.f90 sourcefile~i