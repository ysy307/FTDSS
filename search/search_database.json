esent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine calc_vapor_content_derivatives ( self , state , dvapor_dP , dvapor_dT ) implicit none class ( type_evaporation ), intent ( in ) :: self type ( type_state ), intent ( in ) :: state !> Output: Gradient of vapor content real ( real64 ), intent ( inout ) :: dvapor_dP , dvapor_dT real ( real64 ) :: temperature , pressure , air_content real ( real64 ) :: d_air_content_dP , d_air_content_dT real ( real64 ) :: temperature_K , pressure_abs real ( real64 ) :: rh , drh_dP , drh_dT real ( real64 ) :: rho_sat , drho_sat_dT real ( real64 ) :: rho_w , drho_w_dP , drho_w_dT real ( real64 ) :: ratio , dratio_dP , dratio_dT ! 1. 状態量の準備 call state % temperature % get ( temperature ) call state % pressure % get ( pressure ) call state % air_content % get ( air_content ) call state % dQa_dP % get ( d_air_content_dP ) call state % dQa_dT % get ( d_air_content_dT ) call self % shift_temperature_absolute ( temperature , temperature_K ) ! 2. 各項の計算 ! Relative Humidity & Derivatives call self % calc_relative_humidity ( state , rh ) call self % deriv_relative_humidity_pressure ( state , drh_dP ) call self % deriv_relative_humidity_temperature ( state , drh_dT ) ! Saturation Density (only T dependent) call self % calc_rho_vapor_saturation ( state , rho_sat ) call self % calc_drho_vapor_saturation_dT ( state , drho_sat_dT ) ! Water Density (liquid) call self % calc_rho_water ( state , rho_w ) call self % calc_drho_water_dT ( state , drho_w_dT ) call self % calc_drho_water_dP ( state , drho_w_dP ) ! 3. 蒸気密度比 (Ratio = rho_sat * RH / rho_w) の計算と微分 ratio = ( rho_sat * rh ) / rho_w ! d(Ratio)/dP = (rho_sat/rho_w)*dRH/dP - (rho_sat*RH/rho_w&#94;2)*drho_w/dP dratio_dP = ( rho_sat / rho_w ) * drh_dP - & ( rho_sat * rh / ( rho_w ** 2 )) * drho_w_dP ! d(Ratio)/dT = (1/rho_w)*(drho_sat/dT*RH + rho_sat*dRH/dT) - (Ratio/rho_w)*drho_w/dT dratio_dT = ( 1.0d0 / rho_w ) * ( drho_sat_dT * rh + rho_sat * drh_dT ) - & ( ratio / rho_w ) * drho_w_dT ! 4. 全微分の組み立て (積の微分) ! Vapor = Air * Ratio ! dVapor/dX = dAir/dX * Ratio + Air * dRatio/dX dvapor_dP = d_air_content_dP * ratio + air_content * dratio_dP dvapor_dT = d_air_content_dT * ratio + air_content * dratio_dT end subroutine calc_vapor_content_derivatives","tags":"","url":"proc/calc_vapor_content_derivatives.html"},{"title":"calc_vapor_content_vaporization – FTDSS","text":"private  subroutine calc_vapor_content_vaporization(self, state, vapor_content) theta_v = theta_g * (rho_sat * RH / rho_w) Type Bound type_evaporation Arguments Type Intent Optional Attributes Name class( type_evaporation ), intent(in) :: self type( type_state ), intent(in) :: state real(kind=real64), intent(inout) :: vapor_content Calls proc~~calc_vapor_content_vaporization~~CallsGraph proc~calc_vapor_content_vaporization type_evaporation%calc_vapor_content_vaporization proc~calc_relative_humidity_evaporation type_evaporation%calc_relative_humidity_evaporation proc~calc_vapor_content_vaporization->proc~calc_relative_humidity_evaporation proc~calc_rho_vapor_saturation_abst_physics abst_physics%calc_rho_vapor_saturation_abst_physics proc~calc_vapor_content_vaporization->proc~calc_rho_vapor_saturation_abst_physics proc~calc_rho_water_abst_physics abst_physics%calc_rho_water_abst_physics proc~calc_vapor_content_vaporization->proc~calc_rho_water_abst_physics proc~get_field_dp type_field_dp%get_field_dp proc~calc_