module core_constants_solver
    use, intrinsic :: iso_fortran_env, only: int32
    use :: stdlib_strings, only:strip
    use :: stdlib_ascii, only:to_lower
    use :: core_constants_base, only:type_constant_id, type_constant_value
    implicit none
    private

    ! ==========================================================
    ! Integer Constants & Sequences (Generated)
    ! ==========================================================
    #:for group in constant_groups
        ! --- ${group['obj_name']}$ Constants ---
        #:for item in group['items']
            integer(int32), parameter, public :: ${group['int_prefix']}$_${item[0]}$ = ${item[1]}$
        #:endfor
        #:if 'seq_name' in group
            integer(int32), parameter, public :: ${group['seq_len']}$ = ${len(group['items'])}$
            integer(int32), parameter, public :: ${group['seq_name']}$ (${group['seq_len']}$) = [ &
#:for seq_item in group['seq_order']
                                                 ${group['int_prefix']}$_${seq_item}$${',' if not loop.last else ''}$ &
#:endfor
                                                 ]
        #:endif

    #:endfor

    ! ==========================================================
    ! Derived Type Definitions (Generated)
    ! ==========================================================
    #:for group in constant_groups
        ! --- ${group['obj_name']}$ Type ---
        type :: ${group['type_name']}$
        #:if group['kind'] == 'id'
            #:for item in group['items']
                type(type_constant_id) :: ${item[0]}$ = type_constant_id("${group['category']}$", "${item[2]}$", ${group['int_prefix']}$_${item[0]}$)
            #:endfor
        #:elif group['kind'] == 'value'
            #:for item in group['items']
                type(type_constant_value) :: ${item[0]}$ = type_constant_value("${group['category']}$", "${item[2]}$", ${group['int_prefix']}$_${item[0]}$, "${item[3]}$", ${item[4]}0d0)
            #:endfor
        #:endif
        contains
        procedure, public, pass(self) :: to_id => to_id_${group['suffix']}$
        procedure, public, pass(self) :: to_name => to_name_${group['suffix']}$
        #:if group['kind'] == 'value'
            procedure, public, pass(self) :: to_object_from_id => to_object_from_id_${group['suffix']}$
            procedure, public, pass(self) :: to_object_from_name => to_object_from_name_${group['suffix']}$
            generic, public :: to_object => to_object_from_id, to_object_from_name
        #:endif
        end type ${group['type_name']}$

        type(${group['type_name']}$), parameter, public :: ${group['obj_name']}$ = ${group['type_name']}$ ()

        #:endfor

        contains

!&<
        ! ==========================================================
        ! Helper Procedures (Generated)
        ! ==========================================================
        #:for group in constant_groups
            !> Convert ${group['category']}$ name to ID.
            pure function to_id_${group['suffix']}$(self, name) result(id)
                implicit none
                class(${group['type_name']}$), intent(in) :: self
                character(len=*), intent(in) :: name
                integer(int32) :: id
                character(len=:), allocatable :: lname

                lname = strip(to_lower(name))

                #:for i, item in enumerate(group['items'])
                    ${'if' if i == 0 else 'else if'}$ (lname == strip(to_lower(self%${item[0]}$%name))) then
                    id = self%${item[0]}$%id
                #:endfor
                else
                id = -1
                end if
                end function to_id_${group['suffix']}$

                !> Convert ${group['category']}$ ID to name.
                pure function to_name_${group['suffix']}$(self, id) result(name)
                    implicit none
                    class(${group['type_name']}$), intent(in) :: self
                    integer(int32), intent(in) :: id
                    character(len=:), allocatable :: name

                    #:for i, item in enumerate(group['items'])
                        ${'if' if i == 0 else 'else if'}$ (id == self%${item[0]}$%id) then
                        name = self%${item[0]}$%name
                    #:endfor
                    else
                    name = "unknown"
                    end if
                end function to_name_${group['suffix']}$

                #:if group['kind'] == 'value'
                    !> Convert ${group['category']}$ ID to object (for value types).
                    pure function to_object_from_id_${group['suffix']}$(self, id) result(object)
                        implicit none
                        class(${group['type_name']}$), intent(in) :: self
                        integer(int32), intent(in) :: id
                        type(type_constant_value) :: object

                        #:for i, item in enumerate(group['items'])
                            ${'if' if i == 0 else 'else if'}$ (id == self%${item[0]}$%id) then
                            object = self%${item[0]}$
                        #:endfor
                        else
                        object = type_constant_value("${group['category']}$", "unknown", -1, "unknown", 0.0d0)
                        end if
                        end function to_object_from_id_${group['suffix']}$

                        !> Convert ${group['category']}$ name to object (for value types).
                        pure function to_object_from_name_${group['suffix']}$(self, name) result(object)
                            implicit none
                            class(${group['type_name']}$), intent(in) :: self
                            character(len=*), intent(in) :: name
                            type(type_constant_value) :: object
                            character(len=:), allocatable :: lname

                            lname = strip(to_lower(name))

                            #:for i, item in enumerate(group['items'])
                                ${'if' if i == 0 else 'else if'}$ (lname == strip(to_lower(self%${item[0]}$%name))) then
                                object = self%${item[0]}$
                            #:endfor
                            else
                            object = type_constant_value("${group['category']}$", "unknown", -1, "unknown", 0.0d0)
                            end if
                        end function to_object_from_name_${group['suffix']}$
                    #:endif

                #:endfor
!&>

            end module core_constants_solver
