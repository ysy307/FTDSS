#:set MATRIX_TYPES = ['dense', 'csr', 'coo', 'bsr', 'dia']
#:set TOL = '1.0e-14_real64'
!>
!> Fypp-generated integration test for all matrix types.
!> Exercises every abstract procedure and verifies stored values after each mutation.
!>
program test_matrix
    use, intrinsic :: iso_fortran_env, only: int32, real64, output_unit
    use :: testdrive, only:new_unittest, unittest_type, run_testsuite, error_type, check
    use :: module_core
    use :: module_linalg
    implicit none

    integer(int32) :: stat

    stat = 0
    call run_testsuite(collect_tests, output_unit, stat)

    if (stat /= 0) then
        write (output_unit, '(a,i0,a)') "  [FAIL] ", stat, " test(s) failed."
        error stop 1
    end if

contains

    subroutine collect_tests(tests)
        implicit none
        type(unittest_type), allocatable, intent(out) :: tests(:)
        tests = [ &
#:for TYPE in MATRIX_TYPES[:-1]
                new_unittest("test_${TYPE}$", test_methods_${TYPE}$), &
#:endfor
                new_unittest("test_${MATRIX_TYPES[-1]}$", test_methods_${MATRIX_TYPES[-1]}$) &
                ]
    end subroutine collect_tests

    ! ----------------------------------------------------------------
    ! Sparsity pattern (shared):
    !   N=5 nodes, tridiagonal-like (ptr6/cidx for CSR/BSR; ridx/cidx for COO/DIA).
    !   BSR block size BLK=3.
    !
    ! get_info expected values:
    !   dense : num_nodes=5, num_rows=5, num_cols=5
    !   csr   : num_nodes=5, num_rows=5, num_ptrs=6, nnz=13
    !   coo   : num_nodes=5, num_rows=13 (=size(ridx)), nnz=13
    !   bsr   : num_nodes=5, num_rows=5, num_ptrs=6, num_blocks=13,
    !           num_block_rows=3, num_block_cols=3, nnz=117
    !   dia   : num_nodes=5, num_rows=5, num_cols=5, nnz=15(=5*3 diags),
    !           num_block_cols=3 (reused for num_diags)
    ! ----------------------------------------------------------------

    #:for TYPE in MATRIX_TYPES
        subroutine test_methods_${TYPE}$(error)
            implicit none
            type(error_type), allocatable, intent(out) :: error

            type(type_matrix_${TYPE}$) :: mat
            type(type_matrix_info) :: info
            type(type_vector_dp) :: diag_vec, scale_vec
            type(type_constant_id) :: cur_status

            integer(int32), parameter :: N = 5
            #:if TYPE != 'dense'
                integer(int32), parameter :: NNZ = 13
                integer(int32), parameter :: cidx(NNZ) = [1, 2, 1, 2, 3, 2, 3, 4, 3, 4, 5, 4, 5]
            #:endif
            #:if TYPE in ['csr', 'bsr']
                integer(int32), parameter :: ptr6(6) = [1, 3, 6, 9, 12, 14]
            #:endif
            #:if TYPE in ['coo', 'dia']
                integer(int32), parameter :: ridx(NNZ) = [1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5]
            #:endif
            #:if TYPE == 'bsr'
                integer(int32), parameter :: BLK = 3
            #:endif

            #:if TYPE != 'dense'
                real(real64), allocatable :: local_data(:, :)
                integer(int32) :: local_indices(2, 2)
            #:endif

            integer(int32) :: ierr
            logical :: mkl_ready

            #:if TYPE == 'bsr'
                real(real64), pointer :: vp(:, :, :)
            #:elif TYPE == 'dense' or TYPE == 'dia'
                real(real64), pointer :: vp(:, :)
            #:else
                real(real64), pointer :: vp(:)
            #:endif

            ! ---- initialize ----
            #:if TYPE == 'dense'
                call mat%initialize(N)
            #:elif TYPE == 'csr'
                call mat%initialize(N, ptr6, cidx)
            #:elif TYPE == 'coo'
                call mat%initialize(N, ridx, cidx)
            #:elif TYPE == 'bsr'
                call mat%initialize(N, ptr6, cidx, BLK, BLK)
            #:elif TYPE == 'dia'
                call mat%initialize(N, ridx, cidx)
            #:endif

            ! ---- is_initialized ----
            call check(error, mat%is_initialized()); if (allocated(error)) return

            ! ---- get_info: all format-specific fields ----
            call mat%get_info(info)
            call check(error, info%num_nodes == N); if (allocated(error)) return
            #:if TYPE == 'dense'
                call check(error, info%num_rows == N); if (allocated(error)) return
                call check(error, info%num_cols == N); if (allocated(error)) return
            #:elif TYPE == 'csr'
                call check(error, info%num_rows == N); if (allocated(error)) return
                call check(error, info%num_ptrs == N + 1); if (allocated(error)) return
                call check(error, info%nnz == NNZ); if (allocated(error)) return
            #:elif TYPE == 'coo'
                ! num_rows stores size(ridx) = NNZ, not the number of matrix rows
                call check(error, info%num_rows == NNZ); if (allocated(error)) return
                call check(error, info%nnz == NNZ); if (allocated(error)) return
            #:elif TYPE == 'bsr'
                call check(error, info%num_rows == N); if (allocated(error)) return
                call check(error, info%num_ptrs == N + 1); if (allocated(error)) return
                call check(error, info%num_blocks == NNZ); if (allocated(error)) return
                call check(error, info%num_block_rows == BLK); if (allocated(error)) return
                call check(error, info%num_block_cols == BLK); if (allocated(error)) return
                call check(error, info%nnz == NNZ * BLK * BLK); if (allocated(error)) return
            #:elif TYPE == 'dia'
                call check(error, info%num_rows == N); if (allocated(error)) return
                call check(error, info%num_cols == N); if (allocated(error)) return
                call check(error, info%nnz == N * 3); if (allocated(error)) return
                call check(error, info%num_block_cols == 3); if (allocated(error)) return
            #:endif

            ! ---- get_status + check ----
            cur_status = mat%get_status()
            call check(error, cur_status == MATRIX_STATUS%SUCCESS); if (allocated(error)) return
            call mat%check()

            ! ---- set_value: dense only, (1,1) → 2.0 ----
            #:if TYPE == 'dense'
                call mat%set(MATRIX_OPS%INS, 1, 1, 2.0_real64)
                vp => mat%get_val()
                call check(error, abs(vp(1, 1) - 2.0_real64) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- set_row INS row=1 value=1.0
            !  Dense:   val(1,:) = 1.0  (overwrites (1,1) from 2.0 to 1.0)
            !  CSR/COO: val(1)=1.0, val(2)=1.0  (ind=[1,2] for row 1)
            !  BSR:     val(1,:,blk1)=1.0, val(1,:,blk2)=1.0  (row_block=1)
            !  DIA:     val(1,:)=1.0  (all diagonals at row 1)
            ! ----
            #:if TYPE == 'bsr'
                call mat%set(MATRIX_OPS%INS, 1, 1.0_real64, 1)
                vp => mat%get_val()
                call check(error, abs(vp(1, 1, 1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(1, 2, 2) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dense'
                call mat%set(MATRIX_OPS%INS, 1, 1.0_real64)
                vp => mat%get_val()
                call check(error, abs(vp(1, 1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(1, 2) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dia'
                call mat%set(MATRIX_OPS%INS, 1, 1.0_real64)
                vp => mat%get_val()
                call check(error, abs(vp(1, 1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
            #:else
                call mat%set(MATRIX_OPS%INS, 1, 1.0_real64)
                vp => mat%get_val()
                call check(error, abs(vp(1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(2) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- set_local_matrix ADD (non-dense only)
            !  indices = reshape([1,2,1,2],[2,2]) → col-major: idx(1,1)=1, idx(2,1)=2,
            !                                                    idx(1,2)=1, idx(2,2)=2
            !  Each of idx=1 and idx=2 receives ADD twice (one per j_node).
            !
            !  CSR/COO: val(1) = 1.0(set_row) + 1.0 + 1.0 = 3.0
            !           val(2) = 1.0(set_row) + 1.0 + 1.0 = 3.0
            !  BSR:     val(1,1,1) = 1.0(set_row) + 1.0 + 1.0 = 3.0
            !  DIA:     val(1,1) = 1.0(set_row,d_idx=1) + 1.0 + 1.0 = 3.0
            ! ----
            #:if TYPE != 'dense'
                local_indices = reshape([1, 2, 1, 2], [2, 2])
                #:if TYPE == 'bsr'
                    allocate (local_data(2 * BLK, 2 * BLK))
                #:else
                    allocate (local_data(2, 2))
                #:endif
                local_data = 1.0_real64
                call mat%set(MATRIX_OPS%ADD, 2, local_indices, 1, 1, local_data)
                vp => mat%get_val()
                #:if TYPE == 'csr' or TYPE == 'coo'
                    call check(error, abs(vp(1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
                    call check(error, abs(vp(2) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
                #:elif TYPE == 'bsr'
                    call check(error, abs(vp(1, 1, 1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
                #:elif TYPE == 'dia'
                    call check(error, abs(vp(1, 1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
                #:endif
                deallocate (local_data)
            #:endif

            ! ---- get_diagonal
            !  Dense:   diag(1) = val(1,1) = 1.0
            !  CSR/COO: diag(1) = val at (1,1) entry = 3.0
            !  BSR:     diag(1) = val(1,1, block(1,1)) = 3.0
            !  DIA:     diag(1) = val(1, main_diag_idx=2) = 1.0
            !           (set_row set all diags to 1.0; ADD only hit d_idx=1, not main diag)
            ! ----
            #:if TYPE == 'bsr'
                call diag_vec%initialize(N * BLK)
            #:else
                call diag_vec%initialize(N)
            #:endif
            call mat%get_diagonal(diag_vec)
            block
                real(real64), pointer :: dp(:)
                dp => diag_vec%get_data()
                #:if TYPE == 'dense' or TYPE == 'dia'
                    call check(error, abs(dp(1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
                #:else
                    call check(error, abs(dp(1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
                #:endif
            end block

            ! ---- scale JACOBI by 1.0 vector → values unchanged ----
            #:if TYPE == 'bsr'
                call scale_vec%initialize(N * BLK)
            #:else
                call scale_vec%initialize(N)
            #:endif
            call scale_vec%set(VECTOR_OPS%INS, 1.0_real64)
            call mat%scale(MATRIX_OPS%SCALE_JACOBI, scale_vec)
            cur_status = mat%get_status()
            call check(error, cur_status == MATRIX_STATUS%SUCCESS); if (allocated(error)) return
            vp => mat%get_val()
            #:if TYPE == 'csr' or TYPE == 'coo'
                call check(error, abs(vp(1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'bsr'
                call check(error, abs(vp(1, 1, 1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dia'
                call check(error, abs(vp(1, 1) - 3.0_real64) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dense'
                call check(error, abs(vp(1, 1) - 1.0_real64) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- display (with non-zero values present) ----
            call mat%display(output_unit)

            ! ---- zero_row: zeroes row 1 ----
            #:if TYPE == 'bsr'
                call mat%zero(1, 1)
            #:else
                call mat%zero(1)
            #:endif
            vp => mat%get_val()
            #:if TYPE == 'bsr'
                call check(error, abs(vp(1, 1, 1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(1, 1, 2)) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dense'
                call check(error, abs(vp(1, 1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(1, N)) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dia'
                call check(error, abs(vp(1, 1)) < ${TOL}$); if (allocated(error)) return
            #:else
                call check(error, abs(vp(1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(2)) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- zero_all ----
            call mat%zero()
            vp => mat%get_val()
            #:if TYPE == 'bsr'
                call check(error, abs(vp(1, 1, 1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(BLK, BLK, size(vp, 3))) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dense'
                call check(error, abs(vp(1, 1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N, N)) < ${TOL}$); if (allocated(error)) return
            #:elif TYPE == 'dia'
                call check(error, abs(vp(1, 1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N, size(vp, 2))) < ${TOL}$); if (allocated(error)) return
            #:else
                call check(error, abs(vp(1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(size(vp))) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- commit_to_mkl + is_mkl_handle_ready ----
            call mat%commit_to_mkl(ierr)
            mkl_ready = mat%is_mkl_handle_ready()

            ! ---- destroy ----
            call mat%destroy()
            call check(error, .not. mat%is_initialized()); if (allocated(error)) return

        end subroutine test_methods_${TYPE}$

    #:endfor
end program test_matrix
