#:set VECTOR_TYPES = ['dp', 'int']
#:set TOL = '1.0d-14'
!>
!> Fypp-generated integration test for type_vector_dp and type_vector_int.
!> Exercises every procedure and verifies stored values after each mutation.
!>
!> Storage layout: val((node-1)*num_blocks + block), interleaved.
!> get_size() returns num_nodes (not num_nodes*num_blocks).
!>
program test_vector
    use, intrinsic :: iso_fortran_env, only: int32, real64, output_unit
    use :: testdrive, only:new_unittest, unittest_type, run_testsuite, error_type, check
    use :: module_core
    use :: module_linalg
    implicit none

    integer(int32) :: stat

    stat = 0
    call run_testsuite(collect_tests, output_unit, stat)

    if (stat /= 0) then
        write (output_unit, '(a,i0,a)') "  [FAIL] ", stat, " test(s) failed."
        error stop 1
    end if

contains

    subroutine collect_tests(tests)
        implicit none
        type(unittest_type), allocatable, intent(out) :: tests(:)
        tests = [ &
#:for VTYPE in VECTOR_TYPES[:-1]
                new_unittest("test_${VTYPE}$", test_methods_${VTYPE}$), &
#:endfor
                new_unittest("test_${VECTOR_TYPES[-1]}$", test_methods_${VECTOR_TYPES[-1]}$) &
                ]
    end subroutine collect_tests

    ! ----------------------------------------------------------------
    ! dp test (N=4, NB=1 then NB=2 multi-block):
    !   set_scalar_ins(3) → set_scalar_add(1) → set_array_ins → set_array_add
    !   → val_at_idx_ins → val_at_idx_add → vals_at_idxs_ins → vals_at_idxs_add
    !   → scale(×2) → copy → check → display → zero → destroy
    !   multi-block: set_scalar(row_block), set_value_at_index(row_block)
    !
    ! int test (no set_scalar):
    !   same flow; scale_vector_int does NOT multiply (implementation gap).
    ! ----------------------------------------------------------------

    #:for VTYPE in VECTOR_TYPES
        subroutine test_methods_${VTYPE}$(error)
            implicit none
            type(error_type), allocatable, intent(out) :: error

            type(type_vector_${VTYPE}$) :: vec, src, alpha_vec
            type(type_constant_id) :: cur_status
            integer(int32) :: vsize

            integer(int32), parameter :: N = 4
            #:if VTYPE == 'dp'
                integer(int32), parameter :: NB = 2
            #:endif

            #:if VTYPE == 'dp'
                real(real64), pointer :: vp(:)
            #:else
                integer(int32), pointer :: vp(:)
            #:endif

            ! ---- initialize ----
            call vec%initialize(N)
            call check(error, vec%is_initialized()); if (allocated(error)) return
            vsize = vec%get_size()
            call check(error, vsize == N); if (allocated(error)) return
            cur_status = vec%get_status()
            call check(error, cur_status == VECTOR_STATUS%SUCCESS); if (allocated(error)) return
            call vec%check()

            ! ---- set_scalar INS / ADD (dp only) ----
            !  INS 3.0d0: val = [3,3,3,3]
            !  ADD 1.0d0: val = [4,4,4,4]
            #:if VTYPE == 'dp'
                call vec%set(VECTOR_OPS%INS, 3.0d0)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 3.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N) - 3.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, 1.0d0)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 4.0d0) < ${TOL}$); if (allocated(error)) return
            #:endif

            ! ---- set_array INS / ADD ----
            !  dp:  INS [1,2,3,4] → ADD [0.5,...] → val = [1.5, 2.5, 3.5, 4.5]
            !  int: INS [10,20,30,40] → ADD [5,...] → val = [15, 25, 35, 45]
            #:if VTYPE == 'dp'
                call vec%set(VECTOR_OPS%INS, [1.0d0, 2.0d0, 3.0d0, 4.0d0])
                vp => vec%get_data()
                call check(error, abs(vp(1) - 1.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N) - 4.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, [0.5d0, 0.5d0, 0.5d0, 0.5d0])
                vp => vec%get_data()
                call check(error, abs(vp(1) - 1.5d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N) - 4.5d0) < ${TOL}$); if (allocated(error)) return
            #:else
                call vec%set(VECTOR_OPS%INS, [10, 20, 30, 40])
                vp => vec%get_data()
                call check(error, vp(1) == 10); if (allocated(error)) return
                call check(error, vp(N) == 40); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, [5, 5, 5, 5])
                vp => vec%get_data()
                call check(error, vp(1) == 15); if (allocated(error)) return
                call check(error, vp(N) == 45); if (allocated(error)) return
            #:endif

            ! ---- set_value_at_index INS / ADD ----
            !  dp:  INS idx=2 → 9.0d0;  ADD idx=2 → +1.0d0 → val(2)=10.0d0
            !  int: INS idx=2 → 99;     ADD idx=2 → +1     → val(2)=100
            #:if VTYPE == 'dp'
                call vec%set(VECTOR_OPS%INS, 2, 9.0d0)
                vp => vec%get_data()
                call check(error, abs(vp(2) - 9.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, 2, 1.0d0)
                vp => vec%get_data()
                call check(error, abs(vp(2) - 10.0d0) < ${TOL}$); if (allocated(error)) return
            #:else
                call vec%set(VECTOR_OPS%INS, 2, 99)
                vp => vec%get_data()
                call check(error, vp(2) == 99); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, 2, 1)
                vp => vec%get_data()
                call check(error, vp(2) == 100); if (allocated(error)) return
            #:endif

            ! ---- set_values_at_indices INS / ADD ----
            !  dp:  INS [1,3]→[7,8]       val=[7.0,10.0,8.0,4.5]
            !       ADD [2,4]→[1.0,0.5]   val=[7.0,11.0,8.0,5.0]
            !  int: INS [1,3]→[7,8]        val=[7,100,8,45]
            !       ADD [2,4]→[10,5]       val=[7,110,8,50]
            #:if VTYPE == 'dp'
                call vec%set(VECTOR_OPS%INS, [1, 3], [7.0d0, 8.0d0])
                vp => vec%get_data()
                call check(error, abs(vp(1) - 7.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(3) - 8.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, [2, 4], [1.0d0, 0.5d0])
                vp => vec%get_data()
                call check(error, abs(vp(2) - 11.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(4) - 5.0d0) < ${TOL}$); if (allocated(error)) return
            #:else
                call vec%set(VECTOR_OPS%INS, [1, 3], [7, 8])
                vp => vec%get_data()
                call check(error, vp(1) == 7); if (allocated(error)) return
                call check(error, vp(3) == 8); if (allocated(error)) return

                call vec%set(VECTOR_OPS%ADD, [2, 4], [10, 5])
                vp => vec%get_data()
                call check(error, vp(2) == 110); if (allocated(error)) return
                call check(error, vp(4) == 50); if (allocated(error)) return
            #:endif

            ! ---- scale ----
            !  dp:  val=[7,11,8,5] × [2,...] = [14,22,16,10]
            !  int: scale_vector_int does not multiply → values unchanged
            call alpha_vec%initialize(N)
            #:if VTYPE == 'dp'
                call alpha_vec%set(VECTOR_OPS%INS, 2.0d0)
                call vec%scale(VECTOR_OPS%SCALE_JACOBI, alpha_vec)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 14.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N) - 10.0d0) < ${TOL}$); if (allocated(error)) return
            #:else
                call alpha_vec%set(VECTOR_OPS%INS, [2, 2, 2, 2])
                call vec%scale(VECTOR_OPS%SCALE_JACOBI, alpha_vec)
                vp => vec%get_data()
                call check(error, vp(1) == 7); if (allocated(error)) return
            #:endif
            call alpha_vec%destroy()

            ! ---- copy ----
            !  dp:  src = [5,...] → vec = [5,...] after copy
            !  int: src = [1,2,3,4] → vec = [1,2,3,4] after copy
            call src%initialize(N)
            #:if VTYPE == 'dp'
                call src%set(VECTOR_OPS%INS, 5.0d0)
                call vec%copy(src)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 5.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N) - 5.0d0) < ${TOL}$); if (allocated(error)) return
            #:else
                call src%set(VECTOR_OPS%INS, [1, 2, 3, 4])
                call vec%copy(src)
                vp => vec%get_data()
                call check(error, vp(1) == 1); if (allocated(error)) return
                call check(error, vp(N) == 4); if (allocated(error)) return
            #:endif
            call src%destroy()

            ! ---- check + display ----
            call vec%check()
            call vec%display(output_unit)

            ! ---- zero ----
            call vec%zero()
            vp => vec%get_data()
            #:if VTYPE == 'dp'
                call check(error, abs(vp(1)) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(N)) < ${TOL}$); if (allocated(error)) return
            #:else
                call check(error, vp(1) == 0); if (allocated(error)) return
                call check(error, vp(N) == 0); if (allocated(error)) return
            #:endif

            ! ---- destroy ----
            call vec%destroy()
            call check(error, .not. vec%is_initialized()); if (allocated(error)) return

            ! ---- multi-block test: NB=2 (dp only) ----
            !  Storage: val((node-1)*NB + block), interleaved.
            !  set_scalar(INS, 5.0d0, row_block=1): val(1::2) = 5.0d0 → [5,0,5,0,5,0,5,0]
            !  set_scalar(INS, 3.0d0, row_block=2): val(2::2) = 3.0d0 → [5,3,5,3,5,3,5,3]
            !  set_value_at_index(INS, node=2, val=9.0d0, row_block=1):
            !    idx=(2-1)*2+1=3 → val(3)=9.0d0 → [5,3,9,3,5,3,5,3]
            #:if VTYPE == 'dp'
                call vec%initialize(N, NB)
                call check(error, vec%is_initialized()); if (allocated(error)) return
                call check(error, vec%get_size() == N); if (allocated(error)) return

                call vec%set(VECTOR_OPS%INS, 5.0d0, 1)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 5.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(2)) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%INS, 3.0d0, 2)
                vp => vec%get_data()
                call check(error, abs(vp(1) - 5.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(2) - 3.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%set(VECTOR_OPS%INS, 2, 9.0d0, 1)
                vp => vec%get_data()
                call check(error, abs(vp(3) - 9.0d0) < ${TOL}$); if (allocated(error)) return
                call check(error, abs(vp(4) - 3.0d0) < ${TOL}$); if (allocated(error)) return

                call vec%destroy()
                call check(error, .not. vec%is_initialized()); if (allocated(error)) return
            #:endif

        end subroutine test_methods_${VTYPE}$

    #:endfor
end program test_vector
